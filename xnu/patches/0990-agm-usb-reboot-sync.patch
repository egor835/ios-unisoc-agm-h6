From caba8fecb7f8477dd30e0695b38d4aa3b970a4d8 Mon Sep 17 00:00:00 2001
From: cunny <cunny@MacbookAirM1.lan>
Date: Wed, 28 Oct 2026 01:35:40 +0300
Subject: [PATCH] agm 0990 usb: the reboot request goes through reboot_kernel
 (sync, unmount), PE_halt_restart 30 s later as a fallback

---
 bsd/dev/agm_usb.c | 43 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/bsd/dev/agm_usb.c b/bsd/dev/agm_usb.c
index 16d1c23a1..0de3eddc0 100644
--- a/bsd/dev/agm_usb.c
+++ b/bsd/dev/agm_usb.c
@@ -596,6 +596,47 @@ ub_ep0(void)
 
 /* ---- data: bulk OUT -> ue0 input ---- */
 
+/*
+ * Restart for the test loop as reboot(2) does it (reboot_kernel: sync, unmount, restart), so changes to
+ * the root survive; PE_halt_restart straight away lost them in the HFS journal. A second thread restarts
+ * anyway 30 s later if the orderly path hangs.
+ */
+extern int reboot_kernel(int howto, char *message);
+
+static void
+ub_reboot_thread(void *arg, wait_result_t wr __unused)
+{
+	if (arg != NULL) {
+		int chan;
+		uint64_t deadline;
+		clock_interval_to_deadline(30, NSEC_PER_SEC, &deadline);
+		(void)assert_wait_deadline(&chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("AGM USB: orderly reboot did not finish, restarting\n");
+		(void)PE_halt_restart(1);       /* kPERestartCPU */
+		return;
+	}
+	(void)reboot_kernel(0 /* RB_AUTOBOOT */, (char *)"agm usb");
+}
+
+static void
+ub_reboot(void)
+{
+	static bool started;
+	thread_t t;
+
+	if (started) {
+		return;
+	}
+	started = true;
+	if (kernel_thread_start(ub_reboot_thread, (void *)1, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+	if (kernel_thread_start(ub_reboot_thread, NULL, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
+
 /* The first frames each way in hex (64 bytes), to check what crosses the bus */
 static void
 ub_hexdump(const char *dir, uint64_t nr, const uint8_t *p, uint32_t len)
@@ -630,7 +671,7 @@ ub_rx_frame(void)
 		const uint8_t *udp = f + 14 + (f[14] & 15) * 4;
 		if (udp + 8 + 6 <= f + len && udp[2] == 0x14 && udp[3] == 0x15 && memcmp(udp + 8, "reboot", 6) == 0) {
 			printf("AGM USB: reboot requested over USB\n");
-			(void)PE_halt_restart(1);     /* kPERestartCPU */
+			ub_reboot();
 		}
 	}
 	mbuf_t m = NULL;
