+#define SWEET_DUMP_OFF          (33ull << 30)
+#define SWEET_DUMP_MAX          (64ull << 20)
+int sweet_ufs_dump(uint64_t off, const void *src, uint64_t len);
+/* len bytes at 33 GiB + off of the root partition (block aligned, at most 64 MiB in all) */
+int
+sweet_ufs_dump(uint64_t off, const void *src, uint64_t len)
+{
+	int error = 0;
+
+	if (!su.ready || !su.writable || off % UFS_BLOCK || off > SWEET_DUMP_MAX || len > SWEET_DUMP_MAX - off ||
+	    su.nblocks * UFS_BLOCK < SWEET_DUMP_OFF + SWEET_DUMP_MAX + (64ull << 20)) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_ufs_lock);
+	for (uint64_t done = 0; !error && done < len;) {
+		uint32_t n = (uint32_t)MIN(len - done, (uint64_t)BOUNCE_SIZE);
+		uint32_t blocks = (n + UFS_BLOCK - 1) / UFS_BLOCK;
+		bzero((void *)(su.dma + DMA_BOUNCE), blocks * UFS_BLOCK);
+		memcpy((void *)(su.dma + DMA_BOUNCE), (const uint8_t *)src + done, n);
+		error = ufs_write_blocks(su.first_block + (SWEET_DUMP_OFF + off + done) / UFS_BLOCK, blocks);
+		done += n;
+	}
+	if (!error) {
+		error = ufs_sync_cache();
+	}
+	lck_mtx_unlock(&sweet_ufs_lock);
+	return error;
+}
