+/* For agm_wcn.c (Wi-Fi): the PMIC and the AP GPIOs, shared with this file. */
+bool agm_pmic_rd(uint32_t reg, uint32_t *val);
+bool agm_pmic_wr(uint32_t reg, uint32_t val);
+void agm_gpio_out(unsigned n, int value);
+
+bool
+agm_pmic_rd(uint32_t reg, uint32_t *val)
+{
+	return agm_pmic_map() && pmic_read(reg, val);
+}
+
+bool
+agm_pmic_wr(uint32_t reg, uint32_t val)
+{
+	return agm_pmic_map() && pmic_write(reg, val);
+}
+
+void
+agm_gpio_out(unsigned n, int value)
+{
+	vm_offset_t b = agm_gpio + (n >> 4) * 0x80;
+	uint32_t bit = 1u << (n & 15);
+
+	if (agm_gpio == 0) {
+		return;
+	}
+	wr32(b + GPIO_DMSK, rd32(b + GPIO_DMSK) | bit);
+	wr32(b + GPIO_DIR, rd32(b + GPIO_DIR) | bit);
+	wr32(b + GPIO_INEN, rd32(b + GPIO_INEN) & ~bit);
+	wr32(b + GPIO_DATA, value ? (rd32(b + GPIO_DATA) | bit) : (rd32(b + GPIO_DATA) & ~bit));
+}
