+/* Has the display engine not yet taken the address given last? */
+bool
+AppleCLCD::scanBusy(void)
+{
+#if defined(SWEET_AGM)
+	if (fDpu != NULL) {
+		return !(fDpu[0x1ec / 4] & (1u << 4));          /* INT_RAW: UPDATE_DONE */
+	}
+#endif
+	return (fCtl0[0x18 / 4] & 0x20001) != 0;
+}
+
+/*
+ * AGM H6: the Unisoc DPU (r5p0 on qogirl6, 0x31000000; registers after the vendor dpu_r5p0.c:
+ * CTRL 0x04 (RUN, STOP, REG_UPDATE bit 2), CFG0 0x08 (bit 0 EDPI), layers at 0x30 + 0x30 each:
+ * address +0x00, CTRL +0x10 (bit 0 enable), SIZE +0x14, PITCH +0x18 in pixels, POS +0x1c;
+ * INT_CLR 0x1e4, INT_RAW 0x1ec (bit 4 UPDATE_DONE), DPI_CTRL 0x1f0, MMU_EN 0x804) that u-boot
+ * left scanning the boot framebuffer. In video (DPI) mode with its MMU off, a window-server
+ * frame in the GPU pool (below 4 GB: the layer address is 32 bits) is shown by pointing the
+ * layer at it, taken at the next vsync: no copy and no tearing. Boot-arg agm_dpu=0: copied.
+ */
+void
+AppleCLCD::agmDpuInit(void)
+{
+#if defined(SWEET_AGM)
+	volatile uint32_t *d = (volatile uint32_t *)ml_io_map(0x31000000, 0x1000);
+	uint32_t on = 1, layer = 8;
+
+	(void)PE_parse_boot_argn("agm_dpu", &on, sizeof(on));
+	if (d == NULL) {
+		return;
+	}
+	uint32_t ctrl = d[0x04 / 4], cfg0 = d[0x08 / 4], mmu = d[0x804 / 4];
+	IOLog("SWEET FB: DPU ctrl %#x cfg0 %#x panel %#x blend %#x mmu %#x dpi %#x int raw %#x\n", ctrl, cfg0,
+	    d[0x20 / 4], d[0x24 / 4], mmu, d[0x1f0 / 4], d[0x1ec / 4]);
+	for (uint32_t i = 0; i < 8; i++) {
+		volatile uint32_t *l = d + (0x30 + i * 0x30) / 4;
+		if (l[0x10 / 4] & 1) {
+			IOLog("SWEET FB: DPU layer %u: addr %#x ctrl %#x size %#x pitch %u pos %#x alpha %#x crop %#x\n",
+			    i, l[0], l[0x10 / 4], l[0x14 / 4], l[0x18 / 4], l[0x1c / 4], l[0x20 / 4], l[0x2c / 4]);
+			if (layer == 8 && l[0] == (uint32_t)fPhys) {
+				layer = i;
+			}
+		}
+	}
+	/* (CTRL reads 0 while it scans in video mode: the RUN bit does not stay set; INT_RAW shows its vsyncs) */
+	if (!on || layer == 8 || (cfg0 & 1) || (mmu & 1) || fPhys >= (1ull << 32)) {
+		IOLog("SWEET FB: DPU direct scanout off (agm_dpu %u, boot layer %u, EDPI %u, mmu %#x)\n", on, layer,
+		    cfg0 & 1, mmu);
+		return;
+	}
+	fDpu = d;
+	fDpuLay = 0x30 + layer * 0x30;
+	fBootSrc = (uint32_t)fPhys;
+	fBootStride = d[(fDpuLay + 0x18) / 4] * 4;
+	fScanPhys = fBootSrc;
+	fScanStride = fBootStride;
+	fConsPhys = fBootSrc;                   /* (panics draw into the boot framebuffer: shown again) */
+	sweet_cons_fb = this;
+	sweet_console_show_hook = sweet_cons_show;
+	IOLog("SWEET FB: DPU layer %u scans %#x, stride %u: direct scanout of GPU pool frames\n", layer, fBootSrc,
+	    fBootStride);
+#endif
+}
