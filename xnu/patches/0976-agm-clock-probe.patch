 	agm_dropbox_start();
+	{
+		thread_t probe;
+		if (kernel_thread_start(agm_cpu_probe, NULL, &probe) == KERN_SUCCESS) {
+			thread_deallocate(probe);
+		}
+	}
 	dmsk = 0;
 	if (PE_parse_boot_argn("agm_gpu", &dmsk, sizeof(dmsk)) && dmsk != 0) {
 		extern void AgmMaliGPUStart(void);
diff --git a/iokit/Kernel/arm/AgmMali.cpp b/iokit/Kernel/arm/AgmMali.cpp
index c5fbf159a..433689755 100644
--- a/iokit/Kernel/arm/AgmMali.cpp
+++ b/iokit/Kernel/arm/AgmMali.cpp
@@ -515,6 +515,28 @@ agm_mali_va_free(uint64_t address, uint64_t size)
  * (0.75 V by default), 4 GPLL (650 MHz once set up). Boot-arg agm_gpu_dvfs=N, default 2;
  * u-boot leaves 0.
  */
+/* The GPU's own clock, measured: its cycle counter over 2 ms of the system counter (MHz). */
+static uint32_t
+gpu_mhz(void)
+{
+	volatile uint32_t *m = (volatile uint32_t *)ml_io_map(MALI_PA, 0x1000);
+	uint64_t c0, c1, t0, t1, ns;
+
+	if (m == NULL) {
+		return 0;
+	}
+	m[GPU_CMD / 4] = 5;                                     /* CYCLE_COUNT_START */
+	IODelay(10);
+	c0 = m[0x90 / 4] | ((uint64_t)m[0x94 / 4] << 32);
+	t0 = mach_absolute_time();
+	IODelay(2000);
+	c1 = m[0x90 / 4] | ((uint64_t)m[0x94 / 4] << 32);
+	t1 = mach_absolute_time();
+	m[GPU_CMD / 4] = 6;                                     /* CYCLE_COUNT_STOP */
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	return ns ? (uint32_t)((c1 - c0) * 1000 / ns) : 0;
+}
+
 static void
 dvfs(void)
 {
@@ -525,9 +547,11 @@ dvfs(void)
 	if (d == NULL) {
 		return;
 	}
-	IOLog("AGM MALI: DVFS index %u state %#x upd %#x maps %#x %#x %#x %#x %#x, core clock %#x\n", d[0x8c / 4] & 7,
+	IOLog("AGM MALI: DVFS index %u state %#x upd %#x maps %#x %#x %#x %#x %#x, core clock %#x; measured %u MHz; "
+	    "hold %#x sw %#x bypass %#x gate %#x vdbg %#x cgm %#x sdbg %#x\n", d[0x8c / 4] & 7,
 	    d[0x98 / 4], d[0xa4 / 4], d[0x48 / 4], d[0x4c / 4], d[0x50 / 4], d[0x54 / 4], d[0x58 / 4],
-	    *(volatile uint32_t *)(gapb + 0x4));
+	    *(volatile uint32_t *)(gapb + 0x4), gpu_mhz(), d[0x00 / 4], d[0x20 / 4], d[0x24 / 4], d[0x28 / 4], d[0x2c / 4],
+	    d[0x34 / 4], d[0x38 / 4]);
 	if (index > 3) {
 		return;                 /* (4 and up need the GPLL set up first) */
 	}
@@ -535,8 +559,8 @@ dvfs(void)
 	d[0x8c / 4] = (d[0x8c / 4] & ~7u) | index;
 	__asm__ volatile ("dsb sy" ::: "memory");
 	IODelay(1000);
-	IOLog("AGM MALI: DVFS index now %u, state %#x, core clock %#x\n", d[0x8c / 4] & 7, d[0x98 / 4],
-	    *(volatile uint32_t *)(gapb + 0x4));
+	IOLog("AGM MALI: DVFS index now %u, state %#x, core clock %#x, measured %u MHz; vdbg %#x cgm %#x sdbg %#x\n",
+	    d[0x8c / 4] & 7, d[0x98 / 4], *(volatile uint32_t *)(gapb + 0x4), gpu_mhz(), d[0x2c / 4], d[0x34 / 4], d[0x38 / 4]);
 }
 
