agm-0976: AGM H6 clock measurements: the Mali's own clock (its cycle counter
over 2 ms) before and after the DVFS index is set, with the DVFS debug registers; the CPU clocks
of an A55 and an A75 (eight dependent adds a loop iteration) and, read only, what the firmware's
SIP DVFS service says (DVFS_REV, FREQ_GET, PAIR_GET for both clusters).

diff --git a/bsd/dev/agm_keys.c b/bsd/dev/agm_keys.c
index 6294afefd..8abf20185 100644
--- a/bsd/dev/agm_keys.c
+++ b/bsd/dev/agm_keys.c
@@ -61,6 +61,9 @@
 #include <kern/clock.h>
 #include <kern/locks.h>
 #include <kern/thread.h>
+#include <kern/processor.h>
+#include <sys/kernel.h>
+#include <mach/mach_time.h>
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
@@ -501,6 +504,79 @@ agm_charger_status(void)
 	return agm_chg_stat;
 }
 
+/*
+ * CPU clocks, measured and asked of the firmware (read only). A chain of eight dependent adds
+ * is eight cycles on the A55 and on the A75 alike, so the loop's rate is the core's clock.
+ * The Unisoc SIP service (vendor drivers/firmware/sprd_sip_svc.c, SMC32 fast calls, owner SIP):
+ * DVFS_REV 0x82000600, DVFS_FREQ_GET 0x82000606 (cluster -> a1 Hz), DVFS_PAIR_GET 0x82000607
+ * (cluster, index -> a1 Hz, a2 uV). Clusters: 0 the six A55s, 1 the two A75s.
+ */
+extern processor_t cpu_to_processor(int cpu);
+extern processor_t thread_bind(processor_t processor);
+
+static uint64_t
+agm_sip(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t *r1, uint64_t *r2)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = 0;
+	__asm__ volatile("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+	if (r1 != NULL) {
+		*r1 = x1;
+	}
+	if (r2 != NULL) {
+		*r2 = x2;
+	}
+	return x0;
+}
+
+static uint32_t
+agm_cpu_mhz(void)
+{
+	uint64_t n = 4000000, t0, t1, ns, x = 0;
+
+	t0 = mach_absolute_time();
+	__asm__ volatile(
+		"1:	add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+		"	add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n add %0, %0, #1\n"
+		"	subs %1, %1, #1\n b.ne 1b\n" : "+r"(x), "+r"(n) : : "cc");
+	t1 = mach_absolute_time();
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	return ns ? (uint32_t)(4000000ull * 8 * 1000 / ns) : 0;
+}
+
+static void
+agm_cpu_probe(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t rev = agm_sip(0x82000600, 0, 0, NULL, NULL), f0 = 0, f1 = 0;
+	uint64_t r0 = agm_sip(0x82000606, 0, 0, &f0, NULL), r1 = agm_sip(0x82000606, 1, 0, &f1, NULL);
+
+	printf("AGM CPU: SIP dvfs rev %#llx; cluster 0 freq %llu (%lld), cluster 1 freq %llu (%lld)\n", rev, f0,
+	    (long long)r0, f1, (long long)r1);
+	for (uint32_t c = 0; c < 2; c++) {
+		for (uint32_t i = 0; i < 16; i++) {
+			uint64_t f = 0, v = 0;
+			if ((int64_t)agm_sip(0x82000607, c, i, &f, &v) != 0 || f == 0) {
+				break;
+			}
+			printf("AGM CPU: cluster %u step %u: %llu Hz %llu uV\n", c, i, f, v);
+		}
+	}
+	(void)tsleep(&rev, PZERO, "agmcpu", hz * 20);   /* (after the secondaries have come up) */
+	for (int cpu = 0; cpu < 8; cpu += 6) {
+		processor_t p = cpu_to_processor(cpu);
+		if (p == PROCESSOR_NULL) {
+			continue;
+		}
+		thread_bind(p);
+		thread_block(THREAD_CONTINUE_NULL);
+		printf("AGM CPU: cpu %d (%s) runs at about %u MHz\n", cpu_number(), cpu < 6 ? "A55" : "A75", agm_cpu_mhz());
+	}
+	thread_bind(PROCESSOR_NULL);
+}
+
