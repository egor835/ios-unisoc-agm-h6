+/* the group cipher from the joined network's RSN element (48): CCMP(4) by default, TKIP(3) if so */
+static uint8_t
+group_cipher_of(const struct redwood_sta_bss *b)
+{
+	for (uint32_t o = 0; o + 2 <= b->elements_length;) {
+		uint8_t id = b->elements[o], l = b->elements[o + 1];
+		if (o + 2 + l > b->elements_length) {
+			break;
+		}
+		if (id == 48 && l >= 6 && b->elements[o + 2] == 1 && b->elements[o + 3] == 0 &&
+		    b->elements[o + 4] == 0x00 && b->elements[o + 5] == 0x0f && b->elements[o + 6] == 0xac) {
+			return b->elements[o + 7] == 2 ? CIPHER_TKIP : CIPHER_CCMP;
+		}
+		o += 2u + l;
+	}
+	return CIPHER_CCMP;
+}
