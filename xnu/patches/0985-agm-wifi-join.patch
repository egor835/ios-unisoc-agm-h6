+/* ---- WPA2 PMK from the passphrase (PBKDF2-HMAC-SHA1, 4096), self-contained ---- */
+struct w_sha1 { uint32_t h[5]; uint64_t n; uint8_t b[64]; uint32_t bl; };
+static inline uint32_t w_rol32(uint32_t v, int sh) { return (v << sh) | (v >> (32 - sh)); }
+
+static void
+w_sha1_block(struct w_sha1 *c, const uint8_t *p)
+{
+	uint32_t w[80], a = c->h[0], b = c->h[1], d = c->h[2], e = c->h[3], f = c->h[4];
+	for (int i = 0; i < 16; i++) {
+		w[i] = (uint32_t)p[4 * i] << 24 | (uint32_t)p[4 * i + 1] << 16 | (uint32_t)p[4 * i + 2] << 8 | p[4 * i + 3];
+	}
+	for (int i = 16; i < 80; i++) {
+		w[i] = w_rol32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
+	}
+	for (int i = 0; i < 80; i++) {
+		uint32_t k, x;
+		if (i < 20) { x = (b & d) | (~b & e); k = 0x5A827999; }
+		else if (i < 40) { x = b ^ d ^ e; k = 0x6ED9EBA1; }
+		else if (i < 60) { x = (b & d) | (b & e) | (d & e); k = 0x8F1BBCDC; }
+		else { x = b ^ d ^ e; k = 0xCA62C1D6; }
+		uint32_t t = w_rol32(a, 5) + x + f + k + w[i];
+		f = e; e = d; d = w_rol32(b, 30); b = a; a = t;
+	}
+	c->h[0] += a; c->h[1] += b; c->h[2] += d; c->h[3] += e; c->h[4] += f;
+}
+
+static void
+w_sha1_init(struct w_sha1 *c)
+{
+	c->h[0] = 0x67452301; c->h[1] = 0xEFCDAB89; c->h[2] = 0x98BADCFE; c->h[3] = 0x10325476; c->h[4] = 0xC3D2E1F0;
+	c->n = 0; c->bl = 0;
+}
+
+static void
+w_sha1_update(struct w_sha1 *c, const uint8_t *p, size_t len)
+{
+	c->n += len;
+	while (len > 0) {
+		uint32_t take = (uint32_t)MIN((size_t)(64 - c->bl), len);
+		memcpy(c->b + c->bl, p, take);
+		c->bl += take; p += take; len -= take;
+		if (c->bl == 64) { w_sha1_block(c, c->b); c->bl = 0; }
+	}
+}
+
+static void
+w_sha1_final(struct w_sha1 *c, uint8_t out[20])
+{
+	uint64_t bits = c->n * 8;
+	uint8_t pad = 0x80, z = 0, l[8];
+	w_sha1_update(c, &pad, 1);
+	while (c->bl != 56) { w_sha1_update(c, &z, 1); }
+	for (int i = 0; i < 8; i++) { l[i] = (uint8_t)(bits >> (56 - 8 * i)); }
+	w_sha1_update(c, l, 8);
+	for (int i = 0; i < 5; i++) {
+		out[4 * i] = (uint8_t)(c->h[i] >> 24); out[4 * i + 1] = (uint8_t)(c->h[i] >> 16);
+		out[4 * i + 2] = (uint8_t)(c->h[i] >> 8); out[4 * i + 3] = (uint8_t)c->h[i];
+	}
+}
+
+static void
+w_hmac_sha1(const uint8_t *key, size_t klen, const uint8_t *a, size_t al, const uint8_t *b, size_t bl, uint8_t out[20])
+{
+	uint8_t k[64] = { 0 }, ipad[64], opad[64], inner[20];
+	struct w_sha1 s;
+	if (klen > 64) { w_sha1_init(&s); w_sha1_update(&s, key, klen); w_sha1_final(&s, k); }
+	else { memcpy(k, key, klen); }
+	for (int i = 0; i < 64; i++) { ipad[i] = k[i] ^ 0x36; opad[i] = k[i] ^ 0x5c; }
+	w_sha1_init(&s); w_sha1_update(&s, ipad, 64);
+	if (al) { w_sha1_update(&s, a, al); }
+	if (bl) { w_sha1_update(&s, b, bl); }
+	w_sha1_final(&s, inner);
+	w_sha1_init(&s); w_sha1_update(&s, opad, 64); w_sha1_update(&s, inner, 20); w_sha1_final(&s, out);
+}
+
+static void
+w_pbkdf2_pmk(const uint8_t *pass, size_t plen, const uint8_t *ssid, size_t slen, uint8_t pmk[32])
+{
+	for (uint32_t blk = 1; blk <= 2; blk++) {
+		uint8_t cnt[4] = { 0, 0, 0, (uint8_t)blk }, u[20], t[20];
+		w_hmac_sha1(pass, plen, ssid, slen, cnt, 4, u);
+		memcpy(t, u, 20);
+		for (int i = 1; i < 4096; i++) {
+			w_hmac_sha1(pass, plen, u, 20, NULL, 0, u);
+			for (int j = 0; j < 20; j++) { t[j] ^= u[j]; }
+		}
+		memcpy(pmk + 20 * (blk - 1), t, blk == 1 ? 20 : 12);
+	}
+}
