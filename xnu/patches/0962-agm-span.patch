agm-0962: SCTLR_EL1.SPAN = 1 on SWEET_AGM. Cortex-A55/A75 implement PAN; this
kernel (topaz 0081) never clears it, so with SPAN = 0 each exception entry set PAN
and launchd's first copyout faulted forever in arm_fast_fault.

diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index e01c12496..0d7df610e 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -651,12 +651,23 @@
 #define SCTLR_JOP_KEYS_DEFAULT  0
 #endif
 
+#if defined(SWEET_AGM)
+/*
+ * AGM H6: Cortex-A55/A75 have PAN, this kernel does not use it (topaz 0081).
+ * SPAN (bit 23) = 1 keeps PSTATE.PAN unchanged on exception entry; with 0 every
+ * entry sets PAN and copyin/copyout fault forever in arm_fast_fault.
+ */
+#define SCTLR_SPAN_DEFAULT        (1ULL << 23)
+#else
+#define SCTLR_SPAN_DEFAULT        0
+#endif
+
 #define SCTLR_EL1_DEFAULT \
 	(SCTLR_RESERVED | SCTLR_UCI_ENABLED | SCTLR_nTWE_WFE_ENABLED | SCTLR_DZE_ENABLED | \
 	 SCTLR_I_ENABLED | SCTLR_SED_DISABLED | SCTLR_CP15BEN_ENABLED |                    \
 	 SCTLR_SA0_ENABLED | SCTLR_SA_ENABLED | SCTLR_C_ENABLED | SCTLR_M_ENABLED |        \
 	 SCTLR_CSEH_DEFAULT | SCTLR_DSSBS_DEFAULT |                                        \
-	 SCTLR_ROP_KEYS_DEFAULT | SCTLR_JOP_KEYS_DEFAULT)
+	 SCTLR_ROP_KEYS_DEFAULT | SCTLR_JOP_KEYS_DEFAULT | SCTLR_SPAN_DEFAULT)
 
 /*
  * Coprocessor Access Control Register (CPACR)
