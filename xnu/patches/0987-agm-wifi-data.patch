+	if (mbuf_copydata(packet, 0, length, p + 16) != 0) {
+		lck_mtx_lock(&dp_tx_lock);
+		dp_tx_busy[b] = 0;
+		lck_mtx_unlock(&dp_tx_lock);
+		return false;
+	}
+	if (p[16 + 12] == 0x08 && p[16 + 13] == 0x06) {
+		p[7] = 1u << 2;                         /* ARP: sw_rate, as the vendor's is_special_data */
+	}
+	__builtin_arm_dsb(0xf);
+
+	uint8_t m[7 + 5];
+	m[0] = (uint8_t)(4 | 1u << 4 | (sta_ctx & 7) << 5);   /* type 4, buffer_type 1, interface */
+	m[1] = 7;
+	m[2] = 0x80;                                    /* buffer_inuse */
