+		dumped++;
+		w_hexdump("data tx", p, MIN((uint32_t)length + 16, 64u));
+	}
+	if (!agm_sipc_data_send(m, sizeof(m))) {
+		lck_mtx_lock(&dp_tx_lock);
+		dp_tx_busy[b] = 0;
+		lck_mtx_unlock(&dp_tx_lock);
+		dp_st.tx_fail++;
+		return false;
+	}
+	dp_st.tx++;
+	if ((dp_st.tx & 1023) == 0) {
+		dp_print_stats("every 1024 sent");
+	}
+	return true;
 }
 
