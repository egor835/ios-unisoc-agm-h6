+/* the handshake thread: what the SIPC thread queued, one frame at a time (commands wait for answers here) */
+static void
+hs_thread(__unused void *param, __unused wait_result_t wr)
+{
+	static uint8_t f[EQ_FRAME_MOST];
+
+	for (;;) {
+		uint16_t len = 0;
+		lck_mtx_lock(&eq_lock);
+		if (eq_tail != eq_head) {
+			len = eq[eq_tail % EQ_MOST].len;
+			memcpy(f, eq[eq_tail % EQ_MOST].f, len);
+			eq_tail++;
+		}
+		lck_mtx_unlock(&eq_lock);
+		if (len == 0) {
+			IOSleep(5);
+			continue;
+		}
+		lck_mtx_lock(&hs_lock);
+		w_eapol_rx(f, len);
+		lck_mtx_unlock(&hs_lock);
+	}
+}
+
+static void
+eapol_queue(const uint8_t *e, uint32_t len)
+{
+	if (len > EQ_FRAME_MOST) {
+		printf("AGM WPA: EAPOL frame of %u bytes too long\n", len);
+		return;
+	}
+	lck_mtx_lock(&eq_lock);
+	if (eq_head - eq_tail < EQ_MOST) {
+		eq[eq_head % EQ_MOST].len = (uint16_t)len;
+		memcpy(eq[eq_head % EQ_MOST].f, e, len);
+		eq_head++;
+	} else {
+		printf("AGM WPA: EAPOL queue full, frame dropped\n");
+	}
+	lck_mtx_unlock(&eq_lock);
+}
+
+/* before CONNECT: the handshake to come */
+static void
+hs_prepare(const uint8_t bssid[6], const uint8_t pmk[32], const uint8_t rsn_ie[22], uint8_t group)
+{
+	lck_mtx_lock(&eq_lock);
+	eq_tail = eq_head;                      /* what is left of an earlier join */
+	lck_mtx_unlock(&eq_lock);
+	lck_mtx_lock(&hs_lock);
+	memcpy(hs_bssid, bssid, 6);
+	memcpy(hs_pmk, pmk, 32);
+	memcpy(hs_rsn_ie, rsn_ie, 22);
+	hs_group = group;
+	hs_replay = 0;
+	hs_msg1s = 0;
+	hs_have_ptk = false;
+	bzero(hs_ptk, sizeof(hs_ptk));
+	hs_state = HS_WAIT;
+	lck_mtx_unlock(&hs_lock);
+}
+
+static void
+hs_forget(void)
+{
+	lck_mtx_lock(&hs_lock);
+	hs_state = HS_OFF;
+	hs_have_ptk = false;
+	bzero(hs_pmk, sizeof(hs_pmk));
+	bzero(hs_ptk, sizeof(hs_ptk));
+	lck_mtx_unlock(&hs_lock);
+}
