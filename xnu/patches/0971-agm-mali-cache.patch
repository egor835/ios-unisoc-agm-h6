agm-0971: AgmMali.cpp recovers from a GPU MMU fault or a job that does not end in 2 s by hard
stop + GPU reset (the job counts as failed). AgmMaliGPU buffers are ordinary cached memory,
pushed out of the processors' caches at every submission naming them once mapped and after
WAIT_BO (like topaz gpu_cached=1): write-combined IOBMD allocations get physical addresses
with the top bit lost here (phystokv panic), even with a 40-bit mask; the jobs had failed
with DATA_INVALID_FAULT 0x58 when what Mesa wrote stayed in the caches.

diff --git a/iokit/Kernel/arm/AgmMali.cpp b/iokit/Kernel/arm/AgmMali.cpp
index 6b40c3bf8..10814882c 100644
--- a/iokit/Kernel/arm/AgmMali.cpp
+++ b/iokit/Kernel/arm/AgmMali.cpp
@@ -627,6 +627,34 @@ start_next(void)
 	ring_count--;
 }
 
+static bool gpu_reset(void);
+static void start_next(void);
+
+/*
+ * With hw_lock held: the running job is given up (a fault the GPU waits on for ever, or no end
+ * in time): the slot is stopped, the GPU reset and set up again (page tables stay), and the
+ * job counts as done -- failed -- so the next can start. As panfrost does after such a fault.
+ */
+static void
+recover(const char *why)
+{
+	static uint32_t told;
+
+	if (told++ < 8) {
+		report_faults(why);
+	}
+	wr(JS_BASE + running_slot * 0x80 + 0x20, JS_COMMAND_HARD_STOP);
+	IODelay(100);
+	if (!gpu_reset()) {
+		IOLog("AGM MALI: the GPU did not come back after a reset: given up\n");
+		broken = true;
+	}
+	jobs_failed++;
+	done_seqno = running_seqno;
+	running_seqno = 0;
+	start_next();
+}
+
 /* With hw_lock held: has the running job ended? Then the next one starts. */
 static void
 check(void)
@@ -639,12 +667,9 @@ check(void)
 	uint32_t mmu = rd(MMU_INT_RAWSTAT);
 
 	if (mmu != 0) {
-		static uint32_t told;
-		if (told++ < 8) {
-			report_faults("GPU MMU fault");
-		}
-		/* the job will fail on it: the fault is let go of, as panfrost does for one it cannot mend */
-		wr(MMU_INT_CLEAR, mmu);
+		/* nothing is mapped on demand here: the job would wait on the fault for ever */
+		recover("GPU MMU fault");
+		return;
 	}
 	if (raw & ((1u << slot) | (1u << (16 + slot)))) {
 		if (raw & (1u << (16 + slot))) {
@@ -665,14 +690,7 @@ check(void)
 	uint64_t ns;
 	absolutetime_to_nanoseconds(mach_absolute_time() - running_since, &ns);
 	if (ns > 2 * NSEC_PER_SEC) {
-		report_faults("job takes over 2 s: stopped");
-		wr(JS_BASE + slot * 0x80 + 0x20, JS_COMMAND_HARD_STOP);
-		IODelay(1000);
-		wr(JOB_INT_CLEAR, 0xffffffff);
-		jobs_failed++;
-		done_seqno = running_seqno;
-		running_seqno = 0;
-		start_next();
+		recover("job takes over 2 s");
 	}
 }
 
