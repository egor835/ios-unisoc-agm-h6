+/*
+ * AGM H6: the LCD backlight is PWM channel 2 of the sprd PWM block (0x643f0000; registers per
+ * channel 0x20 apart: PRESCALE +0x0, MOD +0x4, DUTY +0x8, ENABLE +0x18, mainline pwm-sprd.c),
+ * 25 kHz in the stock DT (sprd_backlight). u-boot leaves it running: its period is kept and
+ * only the duty is set. Boot-arg agm_bl=0: left alone.
+ */
+void
+AppleCLCD::agmPwmInit(void)
+{
+#if defined(SWEET_AGM)
+	uint32_t on = 1;
+	(void)PE_parse_boot_argn("agm_bl", &on, sizeof(on));
+	volatile uint32_t *p = (volatile uint32_t *)ml_io_map(0x643f0000, 0x1000);
+	if (p == NULL) {
+		return;
+	}
+	volatile uint32_t *c = p + 0x40 / 4;
+	uint32_t prescale = c[0x0 / 4], mod = c[0x4 / 4], duty = c[0x8 / 4], en = c[0x18 / 4];
+	IOLog("SWEET FB: backlight PWM 2: prescale %u mod %u duty %u enable %#x\n", prescale, mod, duty, en);
+	if (!on || !(en & 1) || mod == 0 || mod > 0xffff) {
+		IOLog("SWEET FB: backlight left alone\n");
+		return;
+	}
+	fPwm = c;
+	fPwmMod = mod;
+	/* the level u-boot left, as a DBV (0..0x7ff), so the first "on" keeps it */
+	fBlLevel = (uint32_t)(((uint64_t)duty * 0x7ff + mod / 2) / mod);
+	if (fBlLevel == 0) {
+		fBlLevel = 0x133;
+	}
+	setProperty("IOMFBBrightnessLevel", (unsigned long long)(200u << 16), 32);
+#endif
+}
