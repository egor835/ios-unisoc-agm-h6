+static void
+drain_all(void)
+{
+	(void)mbox_poll();
+	if (ch[CH_LOG].ready) {
+		sbuf_drain(CH_LOG, "log");
+	}
+	if (ch[CH_ASSERT].ready) {
+		sbuf_drain(CH_ASSERT, "assert");
+	}
+	if (ch[CH_LOOPCHECK].ready) {
+		sbuf_drain(CH_LOOPCHECK, "loopcheck");
+	}
+}
+
+/* the data channels: for now received blocks are counted and handed back */
+static unsigned data_rx[2];
+
+static void
+data_rx_drain(void)
+{
+	uint32_t a, len;
+
+	for (int k = 0; k < 2; k++) {
+		int n = CH_WIFI_DATA0 + k;
+		while (ch[n].ready && sblock_receive(&ch[n], &a, &len)) {
+			if (data_rx[k]++ < 8) {
+				printf("AGM WIFI data%d rx %u bytes\n", k, len);
+				hexdump("data", cpv(a), MIN(len, 64u));
+			}
+			sblock_release(n, a);
+		}
+	}
+}
