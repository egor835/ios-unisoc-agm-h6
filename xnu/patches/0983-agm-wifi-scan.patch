+/* ---- Wi-Fi commands (sc2355 cmdevt.c) ---- */
+#define WIFI_CMD_GET_INFO       1
+#define WIFI_CMD_OPEN           3
+#define WIFI_CMD_SCAN           11
+#define WIFI_CMD_DOWNLOAD_INI   76
+#define WIFI_EVENT_CONNECT      0x80
+#define WIFI_EVENT_SCAN_DONE    0x82
+#define WIFI_EVENT_MGMT_FRAME   0x83
+#define HDR                     12
+
+#include "agm_wifi_ini.h"               /* wifi_board_config.ini, parsed with the vendor's rf_marlin3.c */
+
+static uint8_t rsp_id, rsp_got;
+static int8_t rsp_status;
+static uint8_t rsp_buf[512];
+static uint32_t rsp_len;
+static uint8_t wifi_mac[6];
+static unsigned scan_seen;
+
+static uint16_t
+crc16(const uint8_t *p, uint32_t n)
+{
+	static const uint16_t t[16] = { 0x0000, 0xCC01, 0xD801, 0x1400, 0xF001, 0x3C00, 0x2800, 0xE401,
+		                        0xA001, 0x6C00, 0x7800, 0xB401, 0x5000, 0x9C01, 0x8801, 0x4400 };
+	uint16_t c = 0xffff;
+
+	for (uint32_t i = 0; i < n; i++) {
+		c = t[(p[i] ^ c) & 15] ^ (c >> 4);
+		c = t[((p[i] >> 4) ^ c) & 15] ^ (c >> 4);
+	}
+	return c;
+}
+
+static void
+event_mgmt_frame(vm_offset_t d, uint32_t len)
+{
+	/* {u8 type, channel; s8 signal; u8 reserved; u8 bssid[6]; le16 len; frame} */
+	uint8_t type = *(volatile uint8_t *)d, chan = *(volatile uint8_t *)(d + 1);
+	int8_t sig = *(volatile int8_t *)(d + 2);
+	uint16_t flen = *(volatile uint16_t *)(d + 10);
+	vm_offset_t f = d + 12;
+	char ssid[33] = "";
+
+	if (len < 12 || flen + 12u > len || flen < 36) {
+		printf("AGM WIFI: mgmt frame type %u, %u bytes\n", type, flen);
+		return;
+	}
+	/* 802.11 header 24 (addr3 = BSSID at +16), beacon/probe response fixed 12, then IEs */
+	for (uint32_t o = 36; o + 2 <= flen;) {
+		uint8_t id = *(volatile uint8_t *)(f + o), l = *(volatile uint8_t *)(f + o + 1);
+		if (o + 2 + l > flen) {
+			break;
+		}
+		if (id == 0 && l <= 32) {
+			for (unsigned k = 0; k < l; k++) {
+				char c = *(volatile char *)(f + o + 2 + k);
+				ssid[k] = (c >= 0x20 && c < 0x7f) ? c : '?';
+			}
+			ssid[l] = 0;
+			break;
+		}
+		o += 2u + l;
+	}
+	scan_seen++;
+	printf("AGM WIFI scan: \"%s\" %02x:%02x:%02x:%02x:%02x:%02x channel %u signal %d (type %u, fc %#x)\n", ssid,
+	    *(volatile uint8_t *)(f + 16), *(volatile uint8_t *)(f + 17), *(volatile uint8_t *)(f + 18),
+	    *(volatile uint8_t *)(f + 19), *(volatile uint8_t *)(f + 20), *(volatile uint8_t *)(f + 21),
+	    chan, sig, type, *(volatile uint16_t *)f);
+}
+
 static void
 wifi_rx(void)
 {
@@ -440,48 +551,168 @@ wifi_rx(void)
 	while (ch[CH_WIFI_CMD].ready && sblock_receive(&ch[CH_WIFI_CMD], &a, &len)) {
 		vm_offset_t p = cpv(a);
 		uint8_t common = *(volatile uint8_t *)p, id = *(volatile uint8_t *)(p + 1);
-		printf("AGM WIFI rx: %s id %u ctx %u rsp %u len %u (plen %u) status %d\n",
-		    (common & 7) == 0 ? "cmd response" : (common & 7) == 1 ? "event" : "type?", id, common >> 5,
-		    (common >> 4) & 1, len, *(volatile uint16_t *)(p + 2), *(volatile int8_t *)(p + 8));
-		hexdump("rx", p, len);
+		uint16_t plen = *(volatile uint16_t *)(p + 2);
+		uint32_t dlen = plen > HDR ? plen - HDR : 0;
+
+		if ((common & 7) == 0) {                /* command response */
+			rsp_id = id;
+			rsp_status = *(volatile int8_t *)(p + 8);
+			rsp_len = MIN(dlen, (uint32_t)sizeof(rsp_buf));
+			for (uint32_t i = 0; i < rsp_len; i++) {
+				rsp_buf[i] = *(volatile uint8_t *)(p + HDR + i);
+			}
+			rsp_got = 1;
+		} else if ((common & 7) == 1 && id == WIFI_EVENT_MGMT_FRAME) {
+			event_mgmt_frame(p + HDR, dlen);
+		} else {
+			printf("AGM WIFI rx: %s %#x ctx %u len %u (plen %u)\n", (common & 7) == 1 ? "event" : "type?", id,
+			    common >> 5, len, plen);
+			hexdump("event", p + HDR, MIN(dlen, 64u));
+		}
 		sblock_release(CH_WIFI_CMD, a);
 	}
 }
 
