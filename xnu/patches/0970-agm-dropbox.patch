 /* the display waits for the GPU to be done drawing a surface before it shows it */
+#if defined(SWEET_AGM)
+extern "C" bool agm_mali_wait(uint64_t seqno, uint64_t milliseconds);
+extern "C" void sweet_dcache_flush(vm_offset_t addr, unsigned length);
+
+/* AGM H6: the Mali (AgmMaliGPU.cpp) is not coherent with the processors: once it is done, what
+ * their caches may hold of the surface goes, so the display reads what the GPU wrote. */
+bool
+topaz_surface_drawn(SweetSurface * surface, uint64_t milliseconds)
+{
+	uint32_t fence = surface->drawn;
+
+	if (fence == 0) {
+		return true;
+	}
+	if (!agm_mali_wait(fence, milliseconds)) {
+		return false;
+	}
+	if (surface->kernelAddress() != 0) {
+		sweet_dcache_flush((vm_offset_t)surface->kernelAddress(), surface->allocSize);
+	}
+	(void)__sync_bool_compare_and_swap(&surface->drawn, fence, 0);
+	return true;
+}
+#else
 bool
 topaz_surface_drawn(SweetSurface * surface, uint64_t milliseconds)
 {
@@ -236,6 +260,7 @@ topaz_surface_drawn(SweetSurface * surface, uint64_t milliseconds)
 	}
 	return done;
 }
+#endif
 
