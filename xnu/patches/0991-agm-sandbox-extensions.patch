From 59bd4714f7ccdb4f2d46421a0d8e4ca286582cb8 Mon Sep 17 00:00:00 2001
From: cunny <cunny@MacbookAirM1.lan>
Date: Wed, 28 Oct 2026 03:13:05 +0300
Subject: [PATCH] agm 0991: the sandbox stub grants extensions (issue writes a
 token, consume returns a handle: tccd -> assetsd -> Photos), WCN firmware log
 only with agm_wcnlog=1

---
 bsd/dev/agm_wcn_sipc.c | 13 ++++++--
 bsd/kern/sweet_amfi.c  | 73 ++++++++++++++++++++++++++++++++++++++++--
 2 files changed, 81 insertions(+), 5 deletions(-)

diff --git a/bsd/dev/agm_wcn_sipc.c b/bsd/dev/agm_wcn_sipc.c
index 30d526369..0782190d0 100644
--- a/bsd/dev/agm_wcn_sipc.c
+++ b/bsd/dev/agm_wcn_sipc.c
@@ -316,6 +316,13 @@ sbuf_drain(int n, const char *what)
 	vm_offset_t buf = cpv(rd(c->v, SBUF_HDR + B_RXADDR * 4));
 	char line[161];
 	unsigned k = 0;
+	/* the firmware's own log is megabytes a minute: printed only with boot-arg agm_wcnlog=1 (still drained) */
+	static int quiet = -1;
+	if (quiet < 0) {
+		int on = 0;
+		quiet = !(PE_parse_boot_argn("agm_wcnlog", &on, sizeof(on)) && on);
+	}
+	bool print = !(quiet && n == CH_LOG);
 
 	if (n_ == 0 || n_ > size) {
 		return;
@@ -326,11 +333,13 @@ sbuf_drain(int n, const char *what)
 			line[k++] = b;
 		} else if ((b == '\n' || b == 0 || k == sizeof(line) - 1) && k > 0) {
 			line[k] = 0;
-			printf("AGM WCN %s: %s\n", what, line);
+			if (print) {
+				printf("AGM WCN %s: %s\n", what, line);
+			}
 			k = 0;
 		}
 	}
-	if (k > 0) {
+	if (k > 0 && print) {
 		line[k] = 0;
 		printf("AGM WCN %s: %s\n", what, line);
 	}
diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 49ead9661..da1a980d4 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -36,6 +36,8 @@
 #include <sys/vnode.h>
 #include <security/mac_policy.h>
 #include <sys/sysctl.h>
+#include <kern/kalloc.h>
+#include <machine/atomic.h>
 
 /*
  * AMFI's sysctl node, which the AMFI kext makes on a device: libamfi's
@@ -296,9 +298,14 @@ sweet_amfi_vnode_check_signature(struct vnode *vp, __unused struct label *label,
  * launchd reports mach lookups as "error = 159: Sandbox restriction"
  * (backboardd cannot reach mobilegestalt or iohideventsystem; tccd:
  * "profile not found"). SWEET runs without a sandbox: operations succeed
- * (checks allow, profile init is accepted); the few that must return
- * data (container paths, extension tokens) fail with ENOENT. The first
- * use of each operation number is logged.
+ * (checks allow, profile init is accepted); container paths fail with
+ * ENOENT. Extensions (op 5 issue, op 6 consume) are granted: issue writes
+ * a token in the format of the real ones into the caller's buffer, consume
+ * accepts any token and returns a new handle. Without that, tccd cannot
+ * hand out extensions ("Failed to issue Sandbox Extension for
+ * kTCCServicePhotos") and assetsd aborts ("assetsd requires
+ * TCCPhotosService access"), taking Photos with it. The first use of each
+ * operation number is logged.
  */
 int sweet_sandbox_container_path(user_addr_t arg);
 static uint64_t sweet_sandbox_seen;
@@ -310,6 +317,64 @@ sweet_sandbox_container_path(__unused user_addr_t arg)
 	return ENOENT;
 }
 
+/*
+ * libsystem_sandbox (iOS 16) __sandbox_extension_issue: args {class, unused, path, flags, buffer (0x800
+ * bytes), pid, ...}, the token string goes into buffer. sandbox_extension_consume: args {token, length,
+ * &handle}, an int64 handle comes back.
+ */
+#define SB_TOKEN_MAX    0x800
+
+static int
+sweet_sandbox_issue(struct proc *p, user_addr_t arg)
+{
+	uint64_t a[7];
+	char cls[128] = "", path[MAXPATHLEN] = "";
+	size_t done = 0;
+	int error;
+
+	if (proc_is64bit(p) == 0) {
+		return ENOTSUP;
+	}
+	if ((error = copyin(arg, a, sizeof(a))) != 0) {
+		return error;
+	}
+	if (a[0] != 0) {
+		(void)copyinstr((user_addr_t)a[0], cls, sizeof(cls), &done);
+	}
+	if (a[2] != 0) {
+		(void)copyinstr((user_addr_t)a[2], path, sizeof(path), &done);
+	}
+	char *tok = kalloc_data(SB_TOKEN_MAX, Z_WAITOK | Z_ZERO);
+	if (tok == NULL) {
+		return ENOMEM;
+	}
+	static uint64_t serial;
+	uint64_t n = os_atomic_inc(&serial, relaxed);
+	/* <hash>;<version>;<flags>;<flags>;<flags>;<length of class>;<class>;01;<id>;<serial>;<path> */
+	snprintf(tok, SB_TOKEN_MAX, "%016llx%024llx;00;00000000;00000000;00000000;%016lx;%s;01;01000002;%016llx;%s",
+	    n * 0x9e3779b97f4a7c15ULL, 0ULL, strlen(cls), cls, n, path);
+	error = copyout(tok, (user_addr_t)a[4], strlen(tok) + 1);
+	kfree_data(tok, SB_TOKEN_MAX);
+	return error;
+}
+
+static int
+sweet_sandbox_consume(struct proc *p, user_addr_t arg)
+{
+	uint64_t a[3];
+	static int64_t handles;
+	int error;
+
+	if (proc_is64bit(p) == 0) {
+		return ENOTSUP;
+	}
+	if ((error = copyin(arg, a, sizeof(a))) != 0) {
+		return error;
+	}
+	int64_t h = os_atomic_inc(&handles, relaxed);
+	return a[2] != 0 ? copyout(&h, (user_addr_t)a[2], sizeof(h)) : 0;
+}
+
 static int
 sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 {
@@ -323,7 +388,9 @@ sweet_sandbox_syscall(struct proc *p, int call, user_addr_t arg)
 	case 4:         /* container path (audit token / pid) */
 		return sweet_sandbox_container_path(arg);
 	case 5:         /* extension issue */
+		return sweet_sandbox_issue(p, arg);
 	case 6:         /* extension consume */
+		return sweet_sandbox_consume(p, arg);
 	case 0x43:      /* container expected */
 		return ENOENT;
 	default:
-- 
