+		pmic_read(PMIC_CHGR_PD, &pd);
+		pmic_read(PMIC_CHGR_DET, &det);
+		printf("AGM CHG: pmic pd %#x det %#x\n", pd, det);
+		chg_dump("before");
+		if (chg_read(3) < 0) {
+			printf("AGM CHG: ETA6937 not answering, charger left alone\n");
+			agm_i2c = 0;
+		} else {
+			bool ok = agm_chg_setup();
+			chg_dump(ok ? "after" : "setup failed");
+			agm_chg_poll();
+		}
+	}
 	if (pmic_read(EIC_DMSK, &dmsk)) {
 		pmic_write(EIC_DMSK, dmsk | (1u << EIC_POWER) | (1u << EIC_VOLUP));
 	}
