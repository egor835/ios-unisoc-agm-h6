+#define CHG_ICHG		6u		/* REG4 6:4 + REG5 7:6: 550 + 6 * 100 = 1150 mA */
+#define CHG_SAFETY		((5u << 4) | 10u)	/* REG6: IMCHRG 550 + 5 * 200 = 1550 mA, VMREG 4200 + 10 * 20 = 4400 mV */
+#define CHG_IIN_LIM2		4u		/* REG7 2:0: 300/500/800/1200/1500 mA */
 
 extern int (*PE_halt_restart)(unsigned int type);
 int agm_battery_read(int *mv, int *ma);
+int agm_charger_status(void);
