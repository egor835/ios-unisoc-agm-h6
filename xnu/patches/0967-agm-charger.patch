+static bool
+i2c_init(void)
+{
+	vm_offset_t apb = ml_io_map(APB_PA, 0x2000), apclk = ml_io_map(APCLK_PA, 0x1000);
+
+	agm_i2c = ml_io_map(I2C_PA, 0x1000);
+	if (apb == 0 || apclk == 0 || agm_i2c == 0) {
+		agm_i2c = 0;
+		return false;
+	}
+	wr32(apb + 0x1000, 1u << 26);				/* I2C5 clock gate on */
+	wr32(apclk + 0x44, rd32(apclk + 0x44) & ~0x703u);	/* 26 MHz source, no divider */
+	delay(10);
+	wr32(agm_i2c + I2C_CTL, I2C_CTL_DVD_OPT | (15u << 16) | (4u << 12));	/* FIFO thresholds as Linux */
+	/* 100 kHz: prescale 26 MHz / (4 * 100 kHz) - 1 = 64, SCL high 2/5, low 3/5 */
+	wr32(agm_i2c + I2C_DVD0, (51u << 16) | 76u);
+	wr32(agm_i2c + I2C_DVD1, 0);
+	wr32(agm_i2c + I2C_STA0_DVD, 104);			/* 4 us start hold */
+	wr32(agm_i2c + I2C_RST, 1);
+	wr32(agm_i2c + I2C_STATUS, rd32(agm_i2c + I2C_STATUS) & ~I2C_ST_INT);
+	wr32(agm_i2c + I2C_CTL, rd32(agm_i2c + I2C_CTL) | I2C_CTL_EN | I2C_CTL_INT_EN |
+	    I2C_CTL_NACK_EN | I2C_CTL_TRANS_EN);
+	return true;
+}
+
+/* One I2C message of at most I2C_FIFO bytes; last = end with a stop. */
+static bool
+i2c_msg(uint8_t addr, bool rd, uint8_t *buf, unsigned len, bool last)
+{
+	vm_offset_t b = agm_i2c;
+	uint32_t ctl, st = 0;
+	int i;
+
+	if (b == 0 || len == 0 || len > I2C_FIFO) {
+		return false;
+	}
+	wr32(b + I2C_RST, 1);
+	wr32(b + I2C_ADDR_CFG, (uint32_t)addr << 1);
+	wr32(b + I2C_COUNT, len);
+	ctl = rd32(b + I2C_CTL) & ~(I2C_CTL_MODE | I2C_CTL_STP_EN | I2C_CTL_FULL_INTEN |
+	    I2C_CTL_EMPTY_INTEN | I2C_CTL_START);
+	if (rd) {
+		ctl |= I2C_CTL_MODE;
+	} else if (!last) {
+		ctl |= I2C_CTL_STP_EN;		/* hold the bus for a repeated start */
+	}
+	wr32(b + I2C_CTL, ctl);
+	if (!rd) {
+		for (unsigned n = 0; n < len; n++) {
+			*(volatile uint8_t *)(b + I2C_TX) = buf[n];
+		}
+	}
+	wr32(b + I2C_CTL, ctl | I2C_CTL_START);
+	for (i = 0; i < 10000 && !((st = rd32(b + I2C_STATUS)) & I2C_ST_INT); i++) {
+		delay(1);
+	}
+	bool ok = (st & I2C_ST_INT) && !(st & I2C_ST_RX_ACK);
+	if (ok && rd) {
+		for (unsigned n = 0; n < len; n++) {
+			buf[n] = *(volatile uint8_t *)(b + I2C_RX);
+		}
+	}
+	wr32(b + I2C_CTL, rd32(b + I2C_CTL) & ~I2C_CTL_START);
+	wr32(b + I2C_STATUS, rd32(b + I2C_STATUS) & ~(I2C_ST_INT | I2C_ST_RX_ACK));
+	return ok;
+}
+
+static int
+chg_read(uint8_t reg)
+{
+	uint8_t v = 0;
+
+	if (!i2c_msg(CHG_ADDR, false, &reg, 1, false) || !i2c_msg(CHG_ADDR, true, &v, 1, true)) {
+		return -1;
+	}
+	return v;
+}
+
+static bool
+chg_write(uint8_t reg, uint8_t val)
+{
+	uint8_t b[2] = { reg, val };
+
+	return i2c_msg(CHG_ADDR, false, b, 2, true);
+}
+
+static bool
+chg_update(uint8_t reg, uint8_t mask, uint8_t val)
+{
+	int v = chg_read(reg);
+
+	if (v < 0) {
+		return false;
+	}
+	if (reg == 4) {
+		v &= ~0x80;			/* REG4 bit 7 = RESET, never write it back */
+	}
+	return chg_write(reg, (uint8_t)((v & ~mask) | (val & mask)));
+}
+
+static void
+chg_dump(const char *when)
+{
+	int r[8];
+
+	for (int i = 0; i < 8; i++) {
+		r[i] = chg_read((uint8_t)i);
+	}
+	printf("AGM CHG %s: %02x %02x %02x %02x %02x %02x %02x %02x\n", when,
+	    r[0] & 0x1ff, r[1] & 0x1ff, r[2] & 0x1ff, r[3] & 0x1ff, r[4] & 0x1ff, r[5] & 0x1ff,
+	    r[6] & 0x1ff, r[7] & 0x1ff);
+}
+
+/* eta6937-charger.c hw_init order: safety register first, then the rest. */
+static bool
+agm_chg_setup(void)
+{
+	bool ok = chg_write(6, CHG_SAFETY) &&
+	    chg_update(5, 0xe0, (uint8_t)((CHG_ICHG >> 3) << 6)) &&		/* ICHG[4:3], LOW_CHG off */
+	    chg_update(1, 0x3f, 1u << 3) &&					/* VLOWV 3.4 V, TE on, nCE 0, HZ 0, charge */
+	    chg_update(4, 0x78, (uint8_t)((CHG_ICHG & 7) << 4)) &&		/* ICHG[2:0], ICHG_OFFSET 0 */
+	    chg_update(2, 0xff, (uint8_t)(CHG_VOREG << 2)) &&			/* VOREG, OTG off */
+	    chg_write(0, 0x80) &&						/* TMR_RST */
+	    chg_update(7, 0x0f, (uint8_t)((1u << 3) | CHG_IIN_LIM2));		/* EN_ILIM_2, input limit */
+	uint32_t pd = 0;
+
+	if (pmic_read(PMIC_CHGR_PD, &pd) && (pd & 1u)) {
+		pmic_write(PMIC_CHGR_PD, pd & ~1u);
+	}
+	return ok;
+}
+
+/* Every CHG_POLL_SECS from the input thread: feed, check, re-apply, read status. */
+static void
+agm_chg_poll(void)
+{
+	static unsigned errors;
+	int r0, r2;
+
+	if (!chg_write(0, 0x80) || (r0 = chg_read(0)) < 0 || (r2 = chg_read(2)) < 0) {
+		if (errors++ % 30 == 0) {
+			printf("AGM CHG: I2C error\n");
+		}
+		agm_chg_stat = -1;
+		return;
+	}
+	if ((r2 >> 2) != CHG_VOREG) {
+		bool ok = agm_chg_setup();
+		chg_dump(ok ? "re-applied" : "re-apply failed");
+	}
+	int stat = (r0 >> 4) & 3;
+	if (stat != agm_chg_stat) {
+		uint32_t pd = 0, det = 0;
+		pmic_read(PMIC_CHGR_PD, &pd);
+		pmic_read(PMIC_CHGR_DET, &det);
+		printf("AGM CHG: status %d -> %d (reg0 %#x fault %d, pmic pd %#x det %#x)\n",
+		    agm_chg_stat, stat, r0, r0 & 7, pd, det);
+		agm_chg_stat = stat;
+	}
+}
+
+/* For SweetBattery: 0 ready (no input), 1 charging, 2 done, 3 fault, -1 unknown. */
+int
+agm_charger_status(void)
+{
+	return agm_chg_stat;
+}
