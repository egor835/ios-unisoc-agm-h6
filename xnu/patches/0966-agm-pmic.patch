+/* Calendar from the PMIC RTC (seconds since 1970), like settimeofday(). */
+static void
+agm_rtc_set_calendar(void)
+{
+	uint32_t s = 0, m = 0, h = 0, d = 0, s2 = 0;
+	bool ok = false;
+
+	for (int t = 0; t < 3 && !ok; t++) {
+		ok = pmic_read(RTC + 0x0, &s) && pmic_read(RTC + 0x4, &m) && pmic_read(RTC + 0x8, &h) &&
+		    pmic_read(RTC + 0xc, &d) && pmic_read(RTC + 0x0, &s2) && s == s2;
+	}
+	uint64_t secs = (((uint64_t)(d & 0xffff) * 24 + (h & 0x1f)) * 60 + (m & 0x3f)) * 60 + (s & 0x3f);
+	if (ok && secs > 1600000000ULL) {
+		clock_set_calendar_microtime((clock_sec_t)secs, 0);
+		printf("AGM RTC: calendar set to %llu\n", secs);
+	} else {
+		printf("AGM RTC: no valid time (ok %d, %llu)\n", ok, secs);
 	}
