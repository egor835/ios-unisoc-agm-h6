+/* For SweetBattery: battery voltage (mV) and current (mA, positive = charging). */
+int
+agm_battery_read(int *mv, int *ma)
+{
+	uint32_t v = 0, c = 0;
+
+	if (!agm_pmic_map() || !pmic_read(FGU_VOLTAGE, &v) || !pmic_read(FGU_CURRENT, &c)) {
+		return -1;
+	}
+	*mv = (int)((v * 1000 + FGU_VOL_1000MV_ADC / 2) / FGU_VOL_1000MV_ADC);
+	*ma = ((int)c - FGU_CUR_BASIC_ADC) * 1000 / FGU_CUR_1000MA_ADC;
+	return 0;
+}
+
+/* PEHaltRestart(): power off / restart through the PMIC; panics are left alone. */
+static int
+agm_halt_restart(unsigned int type)
+{
+	uint32_t v = 0;
+
+	if (type == 0) {                /* kPEHaltCPU */
+		printf("AGM: PMIC power off\n");
+		if (pmic_read(PMIC_SLP_CTRL, &v)) {
+			pmic_write(PMIC_SLP_CTRL, v & ~((1u << 2) | (1u << 0)));
+		}
+		pmic_write(PMIC_PWR_PD_HW, 1);
+	} else if (type == 1) {         /* kPERestartCPU */
+		printf("AGM: PMIC restart\n");
+		if (pmic_read(PMIC_RST_STATUS, &v)) {
+			pmic_write(PMIC_RST_STATUS, (v & ~0xffu) | HWRST_STATUS_NORMAL);
+		}
+		if (pmic_read(PMIC_SWRST_CTRL0, &v)) {
+			pmic_write(PMIC_SWRST_CTRL0, v | (1u << 4));
+		}
+		if (pmic_read(PMIC_SOFT_RST_HW, &v)) {
+			pmic_write(PMIC_SOFT_RST_HW, v | 1u);
+		}
+	} else {
+		return -1;
+	}
+	delay(1000000);
+	printf("AGM: PMIC halt/restart had no effect\n");
+	return -1;
+}
