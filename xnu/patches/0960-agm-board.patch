diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index 96c557b0e..789cb9f6c 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -73,9 +73,15 @@ SweetCPU::start(IOService *provider)
 	if (*(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
 		return false;
 	}
+#if defined(SWEET_AGM)
+	/* AGM H6 (UMS9230): MPIDR.MT = 1, Aff1 = core 0-7 (0-5 A55, 6-7 A75), Aff0 = 0 */
+	if ((cpu->phys_id >> 8) > 7 || (cpu->phys_id & 0xff) != 0 ||
+	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+#else
 	/* topaz (SM6225): MPIDR Aff1 = cluster, Aff0 = core: 0x0-0x3 A53, 0x100-0x103 A73 */
 	if ((cpu->phys_id >> 8) > 1 || (cpu->phys_id & 0xff) > 3 ||
 	    topology->num_cpus > SWEET_SMP_MAX_CPUS) {
+#endif
 		panic("SWEET CPU: invalid topology cpu=%u mpidr=0x%x count=%u",
 		    cpu->cpu_id, cpu->phys_id, topology->num_cpus);
 	}
@@ -148,8 +154,14 @@ SweetCPU::startAll(void *arg __unused, wait_result_t result __unused)
 	 * topaz: the ADT lists only the A73 (gold) cores and the shim boots xnu
 	 * on gold CPU 0x100 (the silver cluster has no 16K granule).
 	 */
-	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != 0x100) {
-		panic("SWEET CPU: expected boot MPIDR 0x100 and logical CPU 0, got 0x%x/%u",
+#if defined(SWEET_AGM)
+	/* AGM H6: the shim boots xnu on CPU0 (MPIDR 0x000); every core has the 16K granule. */
+	const uint32_t boot_mpidr = 0x000;
+#else
+	const uint32_t boot_mpidr = 0x100;
+#endif
+	if (topology->boot_cpu->cpu_id != 0 || topology->boot_cpu->phys_id != boot_mpidr) {
+		panic("SWEET CPU: expected boot MPIDR 0x%x and logical CPU 0, got 0x%x/%u", boot_mpidr,
 		    topology->boot_cpu->phys_id, topology->boot_cpu->cpu_id);
 	}
 	for (unsigned int i = 0; i < topology->num_cpus; i++) {
diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 1d3ee1771..30036b154 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
