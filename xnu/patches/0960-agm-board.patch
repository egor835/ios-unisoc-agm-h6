@@ -352,11 +354,20 @@ AppleCLCD::start(IOService *provider)
 		IOLog("SWEET FB: no vsync timer\n");
 		return false;
 	}
+#if defined(SWEET_AGM)
+	/*
+	 * AGM H6: none of the Qualcomm display/GPU blocks exist. fVig0/fCtl0/fDsi/
+	 * fIntf1 stay NULL, which is the path without direct MDP scanout: frames
+	 * are drawn straight into the u-boot framebuffer that the DPU scans out.
+	 */
+	fDsi = NULL;
+#else
 	fVig0 = (volatile uint32_t *)ml_io_map(0x05e05000, 0x1000);
 	fCtl0 = (volatile uint32_t *)ml_io_map(0x05e02000, 0x1000);
 	topaz_adreno_init();
 	setProperty("RedwoodWaitsForGPU", true);         /* present() waits for the GPU (eagl.c reads it) */
 	fDsi = (volatile uint8_t *)ml_io_map(0x05e94000, 0x1000);
+#endif
 	fDsiBuf = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, page_size, 0x00000000fffff000ull);
 	fDsiBufPhys = fDsiBuf ? fDsiBuf->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
@@ -399,7 +410,9 @@ AppleCLCD::start(IOService *provider)
 	}
 	OSSafeReleaseNULL(accel);
 	/* dpu sm6115 catalog: intf_1 at mdp+0x6a800, mdp at 0x5e01000 */
+#if !defined(SWEET_AGM)
 	fIntf1 = (volatile uint32_t *)ml_io_map(0x05e6b000, 0x1000);
+#endif
 	if (fIntf1 != NULL) {
 		volatile uint32_t *r = fIntf1 + 0x800 / 4;
 		r[0x0a8 / 4] = 0x3;     /* FRAME_LINE_COUNT_EN */
diff --git a/makedefs/MakeInc.def b/makedefs/MakeInc.def
index 798f14608..a7473bb9d 100644
--- a/makedefs/MakeInc.def
+++ b/makedefs/MakeInc.def
@@ -63,7 +63,7 @@ MACHINE_FLAGS_ARM64_VMAPPLE = -DARM64_BOARD_CONFIG_VMAPPLE              -march=a
 MACHINE_FLAGS_ARM64_BCM2837 = -DARM64_BOARD_CONFIG_BCM2837
 # topaz: Cortex-A53/A73 are ARMv8.0 (no LSE atomics, RCpc, PAN or FP16). An explicit
 # -mcpu: -arch arm64 otherwise keeps clang's apple-m1 default and its LSE/RCpc features
-MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53 $(if $(filter 1,$(TOPAZ_4K)),-DTOPAZ_4K=1)
+MACHINE_FLAGS_ARM64_SWEET = -DARM64_BOARD_CONFIG_SWEET                -mcpu=cortex-a53 $(if $(filter 1,$(TOPAZ_4K)),-DTOPAZ_4K=1) $(if $(filter 1,$(SWEET_AGM)),-DSWEET_AGM=1)
 
 
 #
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index b926886d8..50954b66d 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1881,7 +1881,11 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
+#if defined(SWEET_AGM)
+	*slot = 0x9e000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+#else
 	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+#endif
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 9fd1cb9cc..dae42d691 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -712,7 +712,11 @@ Ltopaz_fb_block:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
+#if defined(SWEET_AGM)
+	MOV64	x10, 0x9e000000		/* AGM H6 u-boot logo framebuffer, 32 MB aligned */
+#else
 	MOV64	x10, 0x9c000000
+#endif
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
