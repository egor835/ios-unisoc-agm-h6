agm-0960: AGM H6 (Unisoc T606 / UMS9230) board, behind SWEET_AGM=1 in the build
environment (like TOPAZ_4K): CPU topology MT/Aff1 with boot on CPU0, early console
on the u-boot framebuffer 0x9e000000 720x1612, no Qualcomm modem/audio/Adreno/MDP/DSI,
touch/keys/USB or battery gauge/cpufreq. Frames go straight to the boot framebuffer.

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index 143db60b7..b0ebfff27 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -819,6 +819,9 @@ sweet_ufs_init(void)
 	 * topaz; sweettouch=0 / sweetkeys=0 disable them. USB still pokes SM7150
 	 * MMIO (DWC3 at 0xa600000), so it only runs with sweethw=1.
 	 */
+#if defined(SWEET_AGM)
+	printf("SWEET UFS: touch/keys/USB skipped (AGM H6: no Qualcomm QUP/SPMI/DWC3)\n");
+#else
 	int hw = 0;
 	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
 	sweet_touch_init();
@@ -828,6 +831,7 @@ sweet_ufs_init(void)
 	} else {
 		printf("SWEET UFS: USB skipped (topaz, sweethw=0)\n");
 	}
+#endif
 	return 0;
 }
 
