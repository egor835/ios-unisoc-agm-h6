diff --git a/bsd/dev/agm_wifi.c b/bsd/dev/agm_wifi.c
new file mode 100644
index 000000000..216ef90cf
--- /dev/null
+++ b/bsd/dev/agm_wifi.c
@@ -0,0 +1,407 @@
+/*
+ * AGM H6 Wi-Fi: the sc2355 (Marlin3) station for iOS. The transport is agm_wcn_sipc.c (agm_sipc_cmd(), and
+ * agm_wifi_event() for what the firmware says); this file speaks the firmware's Wi-Fi commands (the vendor's
+ * sc2355 driver: kernel_modules/wcn/wlan/wlan_combo/merlion cmdevt.c) and is the station side of
+ * sys/redwood_sta.h with en0 (sys/redwood_net.h), so that wifid finds a Wi-Fi interface and Settings lists
+ * what the scans hear.
+ *
+ * Bring-up (agm_wifi_bring_up, on the SIPC thread): SYNC_VERSION, DOWNLOAD_INI (agm_wifi_ini.h: this phone's
+ * wifi_board_config.ini through the vendor's rf_marlin3.c parser; section 3 answers 1, not an error),
+ * GET_INFO (the firmware knows no MAC: boot-arg agm_wifimac=<12 hex digits>, Android's prodnv wifimac.txt),
+ * OPEN (a station, ctx 0), then en0 and the station are attached.
+ * Scan: SCAN {le32 bits of channels 1-13, le32 0, le16 ssid_len 0, le16 n_5g, le16 5 GHz channels}; the
+ * firmware answers with WIFI_EVENT_MGMT_FRAME (0x83: {u8 type, channel; s8 signal; u8 rsv; bssid[6];
+ * le16 len; the beacon or probe response}) and WIFI_EVENT_SCAN_DONE (0x82).
+ * Joining and the data path are not there yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET) && defined(SWEET_AGM)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_net.h>
+#include <sys/redwood_sta.h>
+
+extern void IOSleep(unsigned int milliseconds);
+extern int agm_sipc_cmd(uint8_t id, uint8_t ctx, const void *data, uint32_t dlen, unsigned timeout_ms,
+    void *rsp, uint32_t *rsplen);
+void agm_wifi_event(uint8_t id, uint8_t ctx, const uint8_t *data, uint32_t len);
+void agm_wifi_bring_up(void);
+
+#define WIFI_CMD_GET_INFO       1
+#define WIFI_CMD_OPEN           3
+#define WIFI_CMD_SYNC_VERSION   9
+#define WIFI_CMD_SCAN           11
+#define WIFI_CMD_DOWNLOAD_INI   76
+#define WIFI_EVENT_CONNECT      0x80
+#define WIFI_EVENT_DISCONNECT   0x81
+#define WIFI_EVENT_SCAN_DONE    0x82
+#define WIFI_EVENT_MGMT_FRAME   0x83
+
+#include "agm_wifi_ini.h"
+
+static uint8_t wifi_mac[6];
+static uint8_t sta_ctx;
+static volatile uint8_t scan_done;
+
+/* ---- what the scans hear ---- */
+#define BSS_MOST        48
+struct bss {
+	struct redwood_sta_bss b;
+	uint64_t heard;                         /* mach_absolute_time */
+	bool used;
+};
+static struct bss bss_table[BSS_MOST];
+static LCK_GRP_DECLARE(wifi_lck_grp, "agm-wifi");
+static LCK_MTX_DECLARE(bss_lock, &wifi_lck_grp);
+
+static uint16_t
+chan_mhz(unsigned c)
+{
+	return (uint16_t)(c == 14 ? 2484 : c < 14 ? 2407 + 5 * c : 5000 + 5 * c);
+}
+
+static uint64_t
+ms_now(void)
+{
+	return mach_absolute_time() / 26000;    /* 26 MHz timebase */
+}
+
+static void
+event_mgmt_frame(const uint8_t *d, uint32_t len)
+{
+	uint8_t chan = d[1];
+	int8_t sig = (int8_t)d[2];
+	uint16_t flen;
+	const uint8_t *f = d + 12;
+
+	if (len < 12) {
+		return;
+	}
+	memcpy(&flen, d + 10, 2);
+	if (flen + 12u > len || flen < 36 || ((f[0] & 0xfc) != 0x80 && (f[0] & 0xfc) != 0x50)) {
+		return;                                 /* only beacons and probe responses */
+	}
+	struct redwood_sta_bss nb;
+	bzero(&nb, sizeof(nb));
+	memcpy(nb.bssid, f + 16, 6);
+	nb.frequency = chan_mhz(chan);
+	nb.rssi = sig;
+	memcpy(&nb.beacon_interval, f + 32, 2);
+	memcpy(&nb.capability, f + 34, 2);
+	nb.elements_length = (uint16_t)MIN((uint32_t)flen - 36, (uint32_t)REDWOOD_STA_ELEMENTS_MOST);
+	memcpy(nb.elements, f + 36, nb.elements_length);
+	for (uint32_t o = 0; o + 2 <= nb.elements_length;) {
+		uint8_t id = nb.elements[o], l = nb.elements[o + 1];
+		if (o + 2 + l > nb.elements_length) {
+			break;
+		}
+		if (id == 0 && l <= 32) {
+			memcpy(nb.ssid, nb.elements + o + 2, l);
+			nb.ssid_length = l;
+			break;
+		}
+		o += 2u + l;
+	}
+
+	lck_mtx_lock(&bss_lock);
+	int slot = -1, oldest = 0;
+	for (int i = 0; i < BSS_MOST; i++) {
+		if (bss_table[i].used && memcmp(bss_table[i].b.bssid, nb.bssid, 6) == 0) {
+			slot = i;
+			break;
+		}
+		if (slot < 0 && !bss_table[i].used) {
+			slot = i;
+		}
+		if (bss_table[i].heard < bss_table[oldest].heard) {
+			oldest = i;
+		}
+	}
+	if (slot < 0) {
+		slot = oldest;
+	}
+	bool fresh = !bss_table[slot].used || memcmp(bss_table[slot].b.bssid, nb.bssid, 6) != 0;
+	bss_table[slot].b = nb;
+	bss_table[slot].heard = ms_now();
+	bss_table[slot].used = true;
+	lck_mtx_unlock(&bss_lock);
+	if (fresh) {
+		printf("AGM WIFI scan: \"%.*s\" %02x:%02x:%02x:%02x:%02x:%02x %u MHz %d dBm\n", nb.ssid_length,
+		    (const char *)nb.ssid, nb.bssid[0], nb.bssid[1], nb.bssid[2], nb.bssid[3], nb.bssid[4], nb.bssid[5],
+		    nb.frequency, nb.rssi);
+	}
+}
+
+/* from the SIPC thread: everything the firmware says by itself */
+void
+agm_wifi_event(uint8_t id, uint8_t ctx, const uint8_t *data, uint32_t len)
+{
+	switch (id) {
+	case WIFI_EVENT_MGMT_FRAME:
+		event_mgmt_frame(data, len);
+		break;
+	case WIFI_EVENT_SCAN_DONE:
+		printf("AGM WIFI: scan done (type %u)\n", len ? data[0] : 0);
+		scan_done = 1;
+		break;
+	default:
+		printf("AGM WIFI: event %#x ctx %u, %u bytes: %02x %02x %02x %02x %02x %02x %02x %02x\n", id, ctx, len,
+		    len > 0 ? data[0] : 0, len > 1 ? data[1] : 0, len > 2 ? data[2] : 0, len > 3 ? data[3] : 0,
+		    len > 4 ? data[4] : 0, len > 5 ? data[5] : 0, len > 6 ? data[6] : 0, len > 7 ? data[7] : 0);
+		break;
+	}
+}
+
+/* ---- the station side of sys/redwood_sta.h ---- */
+static const uint8_t g5_channels[] = { 36, 40, 44, 48, 52, 56, 60, 64, 100, 104, 108, 112, 116, 120, 124, 128,
+	                               132, 136, 140, 149, 153, 157, 161, 165 };
+
+static int
+sta_power(__unused bool on)
+{
+	return 0;                               /* the radio stays up */
+}
+
+static int
+sta_scan(const struct redwood_sta_scan *what)
+{
+	uint8_t buf[12 + sizeof(g5_channels) * 2];
+	uint32_t bits = 0x1fff;                 /* channels 1-13 */
+	uint16_t n5 = 0, ch5[sizeof(g5_channels)];
+
+	if (what != NULL && what->frequency_count > 0) {
+		bits = 0;
+		for (unsigned i = 0; i < what->frequency_count && i < 64; i++) {
+			uint16_t f = what->frequencies[i];
+			if (f >= 2412 && f <= 2472) {
+				bits |= 1u << ((f - 2407) / 5 - 1);
+			} else if (f > 5000 && n5 < sizeof(g5_channels)) {
+				ch5[n5++] = (uint16_t)((f - 5000) / 5);
+			}
+		}
+	} else {
+		for (unsigned i = 0; i < sizeof(g5_channels); i++) {
+			ch5[n5++] = g5_channels[i];
+		}
+	}
+	bzero(buf, sizeof(buf));
+	memcpy(buf, &bits, 4);
+	memcpy(buf + 10, &n5, 2);
+	memcpy(buf + 12, ch5, n5 * 2u);
+	scan_done = 0;
+	int r = agm_sipc_cmd(WIFI_CMD_SCAN, sta_ctx, buf, 12 + n5 * 2u, 3000, NULL, NULL);
+	if (r < 0) {
+		return EIO;
+	}
+	for (unsigned t = 0; t < 10000 && !scan_done; t += 10) {
+		IOSleep(10);
+	}
+	return 0;
+}
+
+static void
+sta_heard(void (*each)(const struct redwood_sta_bss *bss, void *context), void *context)
+{
+	static struct redwood_sta_bss b;
+	uint64_t now = ms_now();
+
+	for (int i = 0; i < BSS_MOST; i++) {
+		bool take = false;
+		lck_mtx_lock(&bss_lock);
+		if (bss_table[i].used && now - bss_table[i].heard < 60000) {
+			b = bss_table[i].b;
+			b.age_ms = (uint32_t)(now - bss_table[i].heard);
+			take = true;
+		}
+		lck_mtx_unlock(&bss_lock);
+		if (take) {
+			each(&b, context);
+		}
+	}
+}
+
+static int
+sta_join(const struct redwood_sta_join *what)
+{
+	printf("AGM WIFI: join \"%.*s\" asked: not there yet\n", what->ssid_length, (const char *)what->ssid);
+	return ENOTSUP;
+}
+
+static int
+sta_leave(void)
+{
+	return 0;
+}
+
+static void
+sta_state(struct redwood_sta_state *state)
+{
+	bzero(state, sizeof(*state));
+	state->phase = REDWOOD_STA_IDLE;
+}
+
+static unsigned
+sta_channels(struct redwood_sta_channel *channels, unsigned most)
+{
+	unsigned n = 0;
+
+	for (unsigned c = 1; c <= 13 && n < most; c++, n++) {
+		channels[n].frequency = chan_mhz(c);
+		channels[n].flags = 0;
+	}
+	for (unsigned i = 0; i < sizeof(g5_channels) && n < most; i++, n++) {
+		channels[n].frequency = chan_mhz(g5_channels[i]);
+		channels[n].flags = (g5_channels[i] >= 52 && g5_channels[i] <= 144) ?
+		    (REDWOOD_STA_CHANNEL_PASSIVE | REDWOOD_STA_CHANNEL_RADAR) : 0;
+	}
+	return n;
+}
+
+static struct redwood_sta_ops sta_ops = {
+	.power = sta_power,
+	.scan = sta_scan,
+	.heard = sta_heard,
+	.join = sta_join,
+	.leave = sta_leave,
+	.state = sta_state,
+	.channels = sta_channels,
+};
+
+static bool
+net_transmit(__unused mbuf_t packet, __unused size_t length)
+{
+	return false;                           /* no data path yet */
+}
+
+static struct redwood_net_link net_link = {
+	.name = "sc2355",
+	.wireless = true,
+	.up = false,
+	.transmit = net_transmit,
+	.poll = NULL,
+};
+
+/* ---- bring-up ---- */
+static uint16_t
+crc16(const uint8_t *p, uint32_t n)
+{
+	static const uint16_t t[16] = { 0x0000, 0xCC01, 0xD801, 0x1400, 0xF001, 0x3C00, 0x2800, 0xE401,
+		                        0xA001, 0x6C00, 0x7800, 0xB401, 0x5000, 0x9C01, 0x8801, 0x4400 };
+	uint16_t c = 0xffff;
+
+	for (uint32_t i = 0; i < n; i++) {
+		c = t[(p[i] ^ c) & 15] ^ (c >> 4);
+		c = t[((p[i] >> 4) ^ c) & 15] ^ (c >> 4);
+	}
+	return c;
+}
+
+static void
+mac_from_boot_arg(void)
+{
+	char arg[16] = "";
+	static const uint8_t fallback[6] = { 0x02, 0x41, 0x47, 0x4d, 0x48, 0x36 };   /* local "AGMH6" */
+	uint8_t m[6] = { 0 };
+	int k = 0;
+
+	memcpy(wifi_mac, fallback, 6);
+	if (!PE_parse_boot_argn("agm_wifimac", arg, sizeof(arg))) {
+		return;
+	}
+	for (; k < 12; k++) {
+		char c = arg[k];
+		int v = c >= '0' && c <= '9' ? c - '0' : c >= 'a' && c <= 'f' ? c - 'a' + 10 :
+		    c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
+		if (v < 0) {
+			break;
+		}
+		m[k / 2] = (uint8_t)(m[k / 2] << 4 | v);
+	}
+	if (k == 12) {
+		memcpy(wifi_mac, m, 6);
+	}
+}
+
+void
+agm_wifi_bring_up(void)
+{
+	static uint8_t buf[1600];
+	uint32_t rlen;
+	int r;
+
+	/* SYNC_VERSION: main_ver 1 and the driver's API versions (api_version.c g_api_array) */
+	static const uint8_t ones[][2] = {
+		{ 0, 41 }, { 56, 80 }, { 82, 82 }, { 84, 85 }, { 91, 91 }, { 128, 134 }, { 136, 137 },
+		{ 160, 161 }, { 176, 179 }, { 224, 225 }, { 242, 248 },
+	};
+	bzero(buf, 4 + 256);
+	buf[0] = 1;
+	for (unsigned k = 0; k < sizeof(ones) / sizeof(ones[0]); k++) {
+		for (unsigned i = ones[k][0]; i <= ones[k][1]; i++) {
+			buf[4 + i] = 1;
+		}
+	}
+	buf[4 + 1] = 2;
+	buf[4 + 11] = 3;
+	if (agm_sipc_cmd(WIFI_CMD_SYNC_VERSION, 0, buf, 4 + 256, 2000, NULL, NULL) < 0) {
+		return;
+	}
+
+	/* DOWNLOAD_INI: {u8 section, 3 bytes pad, data, le16 CRC16(data)} for sections 1..4 */
+	static const struct { const uint8_t *p; uint32_t n; } sec[4] = {
+		{ wifi_ini_sec1, sizeof(wifi_ini_sec1) }, { wifi_ini_sec2, sizeof(wifi_ini_sec2) },
+		{ wifi_ini_sec3, sizeof(wifi_ini_sec3) }, { wifi_ini_sec4, sizeof(wifi_ini_sec4) },
+	};
+	for (unsigned k = 0; k < 4; k++) {
+		uint16_t crc = crc16(sec[k].p, sec[k].n);
+		bzero(buf, 4);
+		buf[0] = (uint8_t)(k + 1);
+		memcpy(buf + 4, sec[k].p, sec[k].n);
+		memcpy(buf + 4 + sec[k].n, &crc, 2);
+		if (agm_sipc_cmd(WIFI_CMD_DOWNLOAD_INI, 0, buf, 4 + sec[k].n + 2, 2000, NULL, NULL) < 0) {
+			return;
+		}
+	}
+
+	/* GET_INFO with the AP version TLV {type 2, len 1, 0 = user} */
+	uint8_t tlv[5] = { 2, 0, 1, 0, 0 };
+	rlen = sizeof(buf);
+	if (agm_sipc_cmd(WIFI_CMD_GET_INFO, 0, tlv, sizeof(tlv), 2000, buf, &rlen) < 0) {
+		return;
+	}
+	if (rlen >= 82) {
+		memcpy(wifi_mac, buf + 76, 6);  /* sprdwl_cmd_fw_info.mac_addr */
+	}
+	if ((wifi_mac[0] | wifi_mac[1] | wifi_mac[2] | wifi_mac[3] | wifi_mac[4] | wifi_mac[5]) == 0) {
+		mac_from_boot_arg();
+	}
+	uint32_t model = 0, fw = 0, capa = 0;
+	memcpy(&model, buf, 4);
+	memcpy(&fw, buf + 8, 4);
+	memcpy(&capa, buf + 16, 4);
+	printf("AGM WIFI: chip %#x firmware %u capa %#x, MAC %02x:%02x:%02x:%02x:%02x:%02x\n", model, fw, capa,
+	    wifi_mac[0], wifi_mac[1], wifi_mac[2], wifi_mac[3], wifi_mac[4], wifi_mac[5]);
+
+	/* OPEN a station interface: {u8 mode (1 station), u8 reserved, mac[6]}; the answer is its ctx */
+	uint8_t open[8] = { 1, 0 };
+	memcpy(open + 2, wifi_mac, 6);
+	rlen = 1;
+	buf[0] = 0;
+	if (agm_sipc_cmd(WIFI_CMD_OPEN, 0, open, sizeof(open), 3000, buf, &rlen) < 0) {
+		return;
+	}
+	sta_ctx = rlen >= 1 ? buf[0] : 0;
+	printf("AGM WIFI: station open, ctx %u\n", sta_ctx);
+
+	memcpy(net_link.address, wifi_mac, 6);
+	memcpy(sta_ops.address, wifi_mac, 6);
+	if (redwood_net_attach(&net_link)) {
+		redwood_sta_attach(&sta_ops);
+		printf("AGM WIFI: en0 and the station are up for iOS\n");
+	}
+}
