From b618d702cec096abf4b2443aa3241da0e87cf37d Mon Sep 17 00:00:00 2001
From: cunny <cunny@MacbookAirM1.lan>
Date: Wed, 28 Oct 2026 01:09:54 +0300
Subject: [PATCH] agm 0989 drop box: owner per entry (flags bit 31, uid/gid)

---
 bsd/dev/agm_dropbox.c | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/bsd/dev/agm_dropbox.c b/bsd/dev/agm_dropbox.c
index e067026bc..6467f7545 100644
--- a/bsd/dev/agm_dropbox.c
+++ b/bsd/dev/agm_dropbox.c
@@ -109,15 +109,19 @@ open_for_writing(const char *path, uint32_t mode, vnode_t *vp, vfs_context_t ctx
 	return vnode_open(path, FWRITE | O_CREAT | O_TRUNC, (int)(mode & 07777), 0, vp, ctx);
 }
 
+/* flags bit 31: owner in bits 15:0 (uid) and 30:16 (gid) instead of root:wheel */
+#define DROP_OWNER              (1u << 31)
+
 static void
-finish_file(vnode_t vp, uint32_t mode, vfs_context_t ctx)
+finish_file(vnode_t vp, uint32_t mode, uint32_t flags, vfs_context_t ctx)
 {
 	struct vnode_attr va;
+	bool owner = (flags & DROP_OWNER) != 0;
 
 	VATTR_INIT(&va);
 	VATTR_SET(&va, va_mode, mode & 07777);
-	VATTR_SET(&va, va_uid, 0);
-	VATTR_SET(&va, va_gid, 0);
+	VATTR_SET(&va, va_uid, owner ? (flags & 0xffff) : 0);
+	VATTR_SET(&va, va_gid, owner ? ((flags >> 16) & 0x7fff) : 0);
 	(void)vnode_setattr(vp, &va, ctx);
 	vnode_close(vp, FWRITE, ctx);
 }
@@ -172,9 +176,9 @@ agm_dropbox_thread(__unused void *arg, __unused wait_result_t wr)
 		}
 		if (!error && (error = open_for_writing(e->path, e->mode, &vp, ctx)) == 0) {
 			error = drop_pass(AGM_DROP_OFF + e->offset, e->size, data, &hash, vp, ctx);
-			finish_file(vp, e->mode, ctx);
+			finish_file(vp, e->mode, e->flags, ctx);
 		}
-		printf("AGM DROP: %s, %llu bytes, mode %o: %s (%d)\n", e->path, e->size, e->mode,
+		printf("AGM DROP: %s, %llu bytes, mode %o owner %#x: %s (%d)\n", e->path, e->size, e->mode, e->flags,
 		    error ? "NOT written" : "written", error);
 		written += error == 0;
 	}
@@ -186,7 +190,7 @@ agm_dropbox_thread(__unused void *arg, __unused wait_result_t wr)
 		if (open_for_writing(AGM_DROP_DONE, 0644, &vp, ctx) == 0) {
 			(void)vn_rdwr(UIO_WRITE, vp, (caddr_t)g, (int)strlen(g), 0, UIO_SYSSPACE, IO_NOAUTH | IO_UNIT,
 			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
-			finish_file(vp, 0644, ctx);
+			finish_file(vp, 0644, 0, ctx);
 		}
 	}
 	printf("AGM DROP: generation %llu: %u of %u files written\n", h->generation, written, h->count);
-- 
