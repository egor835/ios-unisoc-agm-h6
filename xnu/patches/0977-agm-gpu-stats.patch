agm-0977: AgmMaliGPU statistics every 5 s: how long the GPU was busy and on
how many jobs, how many waits for it (WAIT_BO, sync objects) and how long they took, how many
buffers were made, how big and how long it took.

diff --git a/iokit/Kernel/arm/AgmMali.cpp b/iokit/Kernel/arm/AgmMali.cpp
index 433689755..1424422bf 100644
--- a/iokit/Kernel/arm/AgmMali.cpp
+++ b/iokit/Kernel/arm/AgmMali.cpp
@@ -54,6 +54,7 @@ void agm_mali_flush(uint64_t va, uint64_t size);
 uint64_t agm_mali_submit(uint64_t jc, uint32_t requirements);
 bool agm_mali_done(uint64_t seqno);
 uint64_t agm_mali_last(void);
+void agm_mali_busy(uint64_t *ns, uint64_t *jobs);
 bool agm_mali_wait(uint64_t seqno, uint64_t milliseconds);
 void agm_mali_init(void);
 void agm_mali_selftest(void);
@@ -200,6 +201,7 @@ static uint32_t ring_head, ring_count;
 static uint32_t running_slot;
 static uint64_t running_since;
 static uint64_t jobs_done, jobs_failed;
+static uint64_t busy_abs, busy_jobs;           /* since agm_mali_busy() was last asked: the GPU at work (as seen here) */
 static thread_t kick_thread;
 
 static inline uint32_t
@@ -738,6 +740,8 @@ check(void)
 		} else {
 			jobs_done++;
 		}
+		busy_abs += mach_absolute_time() - running_since;
+		busy_jobs++;
 		wr(JOB_INT_CLEAR, (1u << slot) | (1u << (16 + slot)));
 		done_seqno = running_seqno;
 		running_seqno = 0;
@@ -788,6 +792,18 @@ agm_mali_done(uint64_t seqno)
 	return done;
 }
 
+/* How long the GPU has been at work, and on how many jobs, since the last time this was asked. */
+void
+agm_mali_busy(uint64_t *ns, uint64_t *jobs)
+{
+	IOLockLock(hw_lock);
+	absolutetime_to_nanoseconds(busy_abs, ns);
+	*jobs = busy_jobs;
+	busy_abs = 0;
+	busy_jobs = 0;
+	IOLockUnlock(hw_lock);
+}
+
 uint64_t
 agm_mali_last(void)
 {
