+/* ue0, 192.168.7.2/24 (the host side is 192.168.7.1) */
+static void
+ub_if_create(void)
+{
+	struct ifnet_init_eparams init;
+
+	bzero(&init, sizeof(init));
+	init.ver = IFNET_INIT_CURRENT_VERSION;
+	init.len = sizeof(init);
+	init.flags = IFNET_INIT_LEGACY;
+	init.uniqueid = "agm-usb-ecm";
+	init.uniqueid_len = sizeof("agm-usb-ecm") - 1;
+	init.name = "ue";
+	init.unit = 0;
+	init.family = IFNET_FAMILY_ETHERNET;
+	init.type = IFT_ETHER;
+	init.output = ub_if_output;
+	init.demux = ether_demux;
+	init.add_proto = ether_add_proto;
+	init.del_proto = ether_del_proto;
+	init.check_multi = ether_check_multi;
+	init.framer_extended = ether_frameout_extended;
+	init.ioctl = ub_if_ioctl;
+	init.detach = ub_if_detach;
+	init.broadcast_addr = etherbroadcastaddr;
+	init.broadcast_len = ETHER_ADDR_LEN;
+	if (ifnet_allocate_extended(&init, &ub.ifp) != 0) {
+		printf("AGM USB: ifnet_allocate failed\n");
+		ub.ifp = NULL;
+		return;
+	}
+	ifnet_set_addrlen(ub.ifp, ETHER_ADDR_LEN);
+	ifnet_set_hdrlen(ub.ifp, sizeof(struct ether_header));
+	ifnet_set_mtu(ub.ifp, ETHERMTU);
+	ifnet_set_baudrate(ub.ifp, 480000000);
+	ifnet_set_flags(ub.ifp, IFF_BROADCAST | IFF_SIMPLEX | IFF_MULTICAST, 0xffff);
+	if (ifnet_attach(ub.ifp, NULL) != 0) {
+		printf("AGM USB: ifnet_attach failed\n");
+		ub.ifp = NULL;
+		return;
+	}
+	ifnet_set_lladdr(ub.ifp, ub_phone_mac, ETHER_ADDR_LEN);
+
+	errno_t err = proto_plumb(PF_INET, ub.ifp);
+	socket_t so = NULL;
+	if (err == 0) {
+		err = sock_socket(PF_INET, SOCK_DGRAM, 0, NULL, NULL, &so);
+	}
+	if (err == 0) {
+		struct ifaliasreq ifra;
+		bzero(&ifra, sizeof(ifra));
+		snprintf(ifra.ifra_name, sizeof(ifra.ifra_name), "ue0");
+		struct sockaddr_in *a = (struct sockaddr_in *)&ifra.ifra_addr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a80702);         /* 192.168.7.2 */
+		a = (struct sockaddr_in *)&ifra.ifra_mask;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xffffff00);
+		a = (struct sockaddr_in *)&ifra.ifra_broadaddr;
+		a->sin_len = sizeof(*a);
+		a->sin_family = AF_INET;
+		a->sin_addr.s_addr = htonl(0xc0a807ff);
+		err = sock_ioctl(so, SIOCAIFADDR, &ifra);
+		sock_close(so);
+	}
+	ifnet_set_flags(ub.ifp, IFF_UP | IFF_RUNNING, IFF_UP | IFF_RUNNING);
+	printf("AGM USB: ue0 192.168.7.2/24 %s (err %d)\n", err ? "NOT configured" : "up", err);
+}
+
+/* ---- bring-up ---- */
+
+static void
+ub_ldo_on(void)
+{
+	uint32_t p0 = 0, v0 = 0, p1 = 0, v1 = 0;
+
+	(void)agm_pmic_rd(LDO_VDDUSB33_PD, &p0);
+	(void)agm_pmic_rd(LDO_VDDUSB33_VOL, &v0);
+	(void)agm_pmic_wr(LDO_WR_PROT, LDO_WR_UNLOCK);
+	(void)agm_pmic_wr(LDO_VDDUSB33_VOL, (v0 & ~0xffu) | 210);    /* 3.3 V */
+	(void)agm_pmic_wr(LDO_VDDUSB33_PD, p0 & ~1u);
+	ub_sleep_us(1000);
+	(void)agm_pmic_rd(LDO_VDDUSB33_PD, &p1);
+	(void)agm_pmic_rd(LDO_VDDUSB33_VOL, &v1);
+	printf("AGM USB: LDO vddusb33 pd %#x -> %#x, vol %#x -> %#x\n", p0, p1, v0, v1);
+}
+
+static void
+ub_dump(const char *when)
+{
+	printf("AGM USB: %s: aon eb1 %#x rst1 %#x cgm1 %#x phy_test %#x phy_ctrl %#x mux %#x; "
+	    "ana ctl1 %#x pll %#x ctl2 %#x trim %#x iso %#x sel %#x\n", when,
+	    rd32(ub.aon + AON_EB1), rd32(ub.aon + AON_RST1), rd32(ub.aon + AON_CGM_REG1),
+	    rd32(ub.aon + AON_OTG_PHY_TEST), rd32(ub.aon + AON_OTG_PHY_CTRL), rd32(ub.aon + AON_USB_MUX),
+	    rd32(ub.ana + ANA_UTMI_CTL1), rd32(ub.ana + ANA_BATTER_PLL), rd32(ub.ana + ANA_UTMI_CTL2),
+	    rd32(ub.ana + ANA_TRIMMING), rd32(ub.ana + ANA_ISO_SW), rd32(ub.ana + ANA_REG_SEL_CFG_0));
+}
+
+/* sprd_hsphy_init() + sprd_hostphy_set(off) of the vendor PHY driver */
+static void
+ub_phy_init(void)
+{
+	ub_dump("before");
+	ub_ldo_on();
+	aon_set(AON_EB1, OTG_UTMI_EB);
+	aon_set(AON_CGM_REG1, CGM_OTG_REF_EN | CGM_DPHY_REF_EN);
+	ana_upd(ANA_ISO_SW, 1, 0);
+	ana_upd(ANA_BATTER_PLL, ANA_PS_PD, 0);
+	aon_set(AON_OTG_PHY_TEST, OTG_VBUS_VALID_PHYREG);
+	ana_upd(ANA_UTMI_CTL1, ANA_VBUSVLDEXT, ANA_VBUSVLDEXT);
+	aon_set(AON_OTG_PHY_CTRL, UTMI_WIDTH_SEL);
+	ana_upd(ANA_UTMI_CTL1, ANA_DATABUS16_8, ANA_DATABUS16_8);
+	wr32(ub.ana + ANA_TRIMMING, DEVICE_EYE_PATTERN);
+	aon_set(AON_RST1, OTG_PHY_SOFT_RST | OTG_UTMI_SOFT_RST);
+	ub_sleep_us(25000);
+	aon_clr(AON_RST1, OTG_PHY_SOFT_RST | OTG_UTMI_SOFT_RST);
+	/* device mode */
+	aon_set(AON_OTG_PHY_CTRL, USB2_PHY_IDDIG);
+	ana_upd(ANA_REG_SEL_CFG_0, ANA_SEL_PULLDOWNS, ANA_SEL_PULLDOWNS);
+	ana_upd(ANA_UTMI_CTL2, ANA_PULLDOWNS, 0);
+	ana_upd(ANA_UTMI_CTL1, 0xffff, 0);
+	if (rd32(ub.aon + AON_USB_MUX) & 0xf) {
+		aon_clr(AON_USB_MUX, 0xf);              /* pins to USB, not UART/JTAG */
+	}
+	ub_sleep_us(1000);
+	ub_dump("after");
+}
+
+static void
+ub_bus_reset(void)
+{
+	ub.hs = (m_rd8(M_POWER) & POWER_HSMODE) != 0;
+	ub.configured = false;
+	ub.data_alt = 0;
+	ub.ep0 = EP0_IDLE;
+	ub.pending_addr = -1;
+	ub.notify_pending = false;
+	ub.resets++;
+	m_wr8(M_FADDR, 0);
+	ub_fifo_setup();
+	ub_data_eps_reset();
+	printf("AGM USB: bus reset (%s speed), devctl %#x\n", ub.hs ? "high" : "full", m_rd8(M_DEVCTL));
+}
+
+static void
+ub_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	uint64_t last_report = mach_absolute_time(), interval;
+
+	nanoseconds_to_absolutetime(10ull * NSEC_PER_SEC, &interval);
+	for (;;) {
+		bool busy = false;
+		uint8_t usb = m_rd8(M_INTRUSB);
+		uint16_t tx = m_rd16(M_INTRTX);
+		ub.intrrx_seen |= m_rd16(M_INTRRX);
+
+		if (usb & IUSB_RESET) {
+			ub_bus_reset();
+		}
+		if (usb & IUSB_DISCON) {
+			ub.configured = false;
+			printf("AGM USB: disconnect\n");
+		}
+		if ((usb & IUSB_SUSPEND) && ub.configured) {
+			printf("AGM USB: suspend\n");
+		}
+		if (tx & 1) {
+			ub_ep0();
+			busy = true;
+		}
+		if (ub.configured) {
+			for (int i = 0; i < 8 && ub_rx(); i++) {
+				busy = true;
+			}
+			if (ub.data_alt == 1) {
+				if (ub.notify_pending) {
+					ub_notify();
+				}
+				/*
+				 * Keep the IN FIFO fed while there is something to send: a 512-byte packet leaves
+				 * in ~10 us, much less than a sleep, so wait for TXPKTRDY by spinning.
+				 */
+				for (int i = 0, spins = 0; i < 256; i++) {
+					if (ub_tx()) {
+						busy = true;
+						spins = 0;
+					} else if (ub.tx_off < ub.tx_len && spins++ < 100) {
+						delay(1);
+					} else {
+						break;
+					}
+				}
+			}
+		}
+		if (mach_absolute_time() - last_report > interval) {
+			last_report = mach_absolute_time();
+			printf("AGM USB: ue0 rx %llu frames (%llu packets) tx %llu frames, %llu dropped, %llu resets, "
+			    "txq drops %llu, power %#x devctl %#x intrrx %#x rxcsr %#x rxmaxp %u txcsr %#x cfg %d alt %u\n",
+			    ub.rx_frames, ub.rx_pkts, ub.tx_frames, ub.rx_drops, ub.resets, ub.tx_qdrops, m_rd8(M_POWER), m_rd8(M_DEVCTL),
+			    ub.intrrx_seen, m_rd16(M_EP(EP_DATA) + M_RXCSR), m_rd16(M_EP(EP_DATA) + M_RXMAXP),
+			    m_rd16(M_EP(EP_DATA) + M_TXCSR), ub.configured, ub.data_alt);
+			ub.intrrx_seen = 0;
+		}
+		ub_sleep_us(busy ? 50 : 500);
+	}
+}
+
+/*
+ * Live console log over USB Ethernet (as topaz 0077): every 100 ms the new bytes of the console ring
+ * (bsd/dev/sweet_ufs.c) go as UDP datagrams to 192.168.7.255:5140 (broadcast: no ARP needed, so the log
+ * also gets out when nothing reaches the phone; on the PC: socat -u UDP-RECV:5140 -), starting
+ * with the last 64 KiB so the boot is included. Nothing here may print (it would feed itself).
+ */
+extern uint32_t sweet_log_copy(uint64_t *pos, char *out, uint32_t max);
+extern uint64_t sweet_log_position(void);
+
+static void
+ub_log_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	static char chunk[1400];
+	socket_t so = NULL;
+	struct sockaddr_in to;
+	uint64_t pos = sweet_log_position();
+	int log_chan;
+
+	pos = pos > 65536 ? pos - 65536 : 0;
+	bzero(&to, sizeof(to));
+	to.sin_len = sizeof(to);
+	to.sin_family = AF_INET;
+	to.sin_port = htons(5140);
+	to.sin_addr.s_addr = htonl(0xc0a807ff);         /* 192.168.7.255 */
+	for (;;) {
+		uint64_t deadline;
+		clock_interval_to_deadline(100, NSEC_PER_MSEC, &deadline);
+		(void)assert_wait_deadline(&log_chan, THREAD_UNINT, deadline);
+		thread_block(THREAD_CONTINUE_NULL);
+		if (!ub.configured || ub.data_alt != 1) {
+			continue;
+		}
+		if (so == NULL && sock_socket(PF_INET, SOCK_DGRAM, IPPROTO_UDP, NULL, NULL, &so) != 0) {
+			so = NULL;
+			continue;
+		}
+		int on = 1;
+		(void)sock_setsockopt(so, SOL_SOCKET, SO_BROADCAST, &on, sizeof(on));
+		uint32_t n;
+		uint64_t keep = pos;
+		/* the log gives way to other traffic: at most a quarter of the TX queue */
+		while (ub.txq_count < TXQ / 4 && (n = sweet_log_copy(&pos, chunk, sizeof(chunk))) > 0) {
+			struct iovec iov = { .iov_base = chunk, .iov_len = n };
+			struct msghdr msg = {
+				.msg_name = &to, .msg_namelen = sizeof(to),
+				.msg_iov = &iov, .msg_iovlen = 1,
+			};
+			size_t sent = 0;
+			if (sock_send(so, &msg, 0, &sent) != 0) {
+				pos = keep;     /* no route/ARP yet: resend this chunk later */
+				break;
+			}
+			keep = pos;
+		}
+	}
+}
+
+static void
+ub_start_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	thread_t thread;
+
+	ub.aon = ml_io_map(AON_PA, AON_SIZE);
+	ub.ana = ml_io_map(ANA_PA, ANA_SIZE);
+	ub.musb = ml_io_map(MUSB_PA, MUSB_SIZE);
+	if (ub.aon == 0 || ub.ana == 0 || ub.musb == 0) {
+		printf("AGM USB: MMIO map failed\n");
+		return;
+	}
+	ub_phy_init();
+	if (!(rd32(ub.aon + AON_EB1) & OTG_UTMI_EB)) {
+		printf("AGM USB: otg clock did not turn on, controller not touched\n");
+		return;
+	}
+	m_wr8(M_INDEX, 0);
+	printf("AGM USB: MUSB hwvers %#x epinfo %#x raminfo %#x configdata %#x power %#x devctl %#x "
+	    "dpktbufdis tx %#x rx %#x\n",
+	    m_rd16(M_HWVERS), m_rd8(M_EPINFO), m_rd8(M_RAMINFO), m_rd8(M_EP(0) + M_CONFIGDATA),
+	    m_rd8(M_POWER), m_rd8(M_DEVCTL), m_rd16(M_TX_DPKTBUFDIS), m_rd16(M_RX_DPKTBUFDIS));
+
+	/* disconnected and quiet, then the FIFO layout, then the pull-up on D+ */
+	m_wr8(M_POWER, m_rd8(M_POWER) & ~POWER_SOFTCONN);
+	m_wr8(M_TESTMODE, 0);
+	m_wr8(M_INTRUSBE, 0);
+	m_wr16(M_INTRTXE, 0);
+	m_wr16(M_INTRRXE, 0);
+	(void)m_rd8(M_INTRUSB);
+	(void)m_rd16(M_INTRTX);
+	(void)m_rd16(M_INTRRX);
+	m_wr8(M_FADDR, 0);
+	if (kmem_alloc_contig(kernel_map, &ub.rxd, RXD_SIZE, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("AGM USB: no DMA memory\n");
+		return;
+	}
+	ppnum_t pn = pmap_find_phys(kernel_pmap, (addr64_t)ub.rxd);
+	if (!pn) {
+		printf("AGM USB: DMA memory has no physical page\n");
+		return;
+	}
+	ub.rxd_pa = ptoa_64(pn);
+	printf("AGM USB: rx DMA area at %#llx, chn %d cfg %#x intr %#x\n", ub.rxd_pa, RX_CHN,
+	    m_rd32(DMA_CHN_CFG(RX_CHN)), m_rd32(DMA_CHN_INTR(RX_CHN)));
+	ub_fifo_setup();
+	ub_data_eps_reset();
+	ub_if_create();
+	ub_sleep_us(50000);
+	/* status bits are the same with interrupts enabled; the SPI itself stays off in the GIC */
+	m_wr8(M_INTRUSBE, IUSB_SUSPEND | IUSB_RESUME | IUSB_RESET | IUSB_DISCON);
+	m_wr16(M_INTRTXE, (1u << 0) | (1u << EP_DATA) | (1u << EP_NOTIFY));
+	m_wr16(M_INTRRXE, 1u << EP_DATA);
+	m_wr8(M_POWER, POWER_HSENAB | POWER_SOFTCONN);
+	ub_sleep_us(10000);
+	printf("AGM USB: soft connect: power %#x devctl %#x\n", m_rd8(M_POWER), m_rd8(M_DEVCTL));
+
+	if (kernel_thread_start(ub_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	int livelog = 1;
+	PE_parse_boot_argn("agm_usblog", &livelog, sizeof(livelog));
+	if (livelog && ub.ifp != NULL && kernel_thread_start(ub_log_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+
+void
+agm_usb_start(void)
+{
+	int on = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("agm_usb", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	static lck_grp_t *grp;
+	grp = lck_grp_alloc_init("agm_usb", LCK_GRP_ATTR_NULL);
+	ub.lock = lck_mtx_alloc_init(grp, LCK_ATTR_NULL);
+	if (kernel_thread_start(ub_start_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
